---
import Layout from '~/layouts/PageLayout.astro';
import { ssrBlogsApi } from '~/utils/ssr-api';

const metadata = {
  title: 'Blog - MarketMindAI | Latest AI Tools & Productivity Insights',
  description: 'Read the latest insights, tips, and news about AI tools, productivity, and business solutions. Expert reviews and guides for modern businesses.',
  keywords: 'ai blog, productivity tips, business insights, tool reviews, ai news',
};

// Fetch blogs at build time (SSR/SSG)
let blogs: any[] = [];
let errorMessage = '';

try {
  blogs = await ssrBlogsApi.getAll({ limit: 100, status: 'published', sort: 'newest' });
  console.log(`✅ SSR: Loaded ${blogs.length} published blogs`);
} catch (error) {
  console.error('❌ Error fetching blogs:', error);
  errorMessage = 'Failed to load blogs. Please try again later.';
}
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Latest from Our Blog
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Insights, tips, and best practices about AI tools, productivity, and business growth. {blogs.length} articles and counting!
      </p>
    </div>

    {errorMessage ? (
      <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-6 text-center">
        <p class="text-red-800 dark:text-red-200">{errorMessage}</p>
      </div>
    ) : (
      <div>
        <!-- Filters -->
        <div class="mb-8 flex flex-wrap gap-4 items-center justify-center">
          <!-- Search -->
          <input
            type="text"
            id="search-input"
            placeholder="Search blogs..."
            class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 min-w-[300px]"
          />

          <!-- Sort Filter -->
          <select
            id="sort-filter"
            class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
          >
            <option value="newest">Newest First</option>
            <option value="oldest">Oldest First</option>
            <option value="most_viewed">Most Viewed</option>
          </select>

          <!-- AI Generated Filter -->
          <select
            id="ai-filter"
            class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All Blogs</option>
            <option value="false">Human Written</option>
            <option value="true">AI Generated</option>
          </select>
        </div>

        <!-- Blogs Grid (Pre-rendered with all blogs) -->
        <div id="blogs-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {blogs.map((blog) => (
            <a 
              href={`/blogs/${blog.slug}`} 
              class="block group" 
              data-testid={`blog-card-${blog.slug}`}
              data-blog={JSON.stringify({ 
                title: blog.title.toLowerCase(), 
                isAi: blog.is_ai_generated, 
                views: blog.view_count,
                date: blog.published_at 
              })}
            >
              <article class="bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-xl transition-shadow overflow-hidden h-full flex flex-col">
                <!-- Featured Image -->
                {blog.featured_image ? (
                  <div class="aspect-video bg-gray-200 dark:bg-gray-700 overflow-hidden">
                    <img 
                      src={blog.featured_image} 
                      alt={blog.title} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <div class="aspect-video bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
                    <span class="text-white text-4xl">📝</span>
                  </div>
                )}

                <div class="p-6 flex-1 flex flex-col">
                  <!-- Tags -->
                  {blog.tags && blog.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-3">
                      {blog.tags.slice(0, 3).map((tag: string) => (
                        <span class="text-xs px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}

                  <!-- Title -->
                  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 line-clamp-2">
                    {blog.title}
                  </h2>

                  <!-- Excerpt -->
                  <p class="text-gray-600 dark:text-gray-300 mb-4 line-clamp-3 flex-1">
                    {blog.excerpt || blog.content.substring(0, 150) + '...'}
                  </p>

                  <!-- Meta Info -->
                  <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400 pt-4 border-t border-gray-200 dark:border-gray-700">
                    <div class="flex items-center space-x-4">
                      <span class="flex items-center">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        {blog.view_count}
                      </span>
                      <span class="flex items-center">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        {blog.reading_time} min
                      </span>
                    </div>
                    {blog.is_ai_generated && (
                      <span class="px-2 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded text-xs font-medium">
                        AI
                      </span>
                    )}
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>

        <!-- No Results (initially hidden, shown by JS filter) -->
        <div id="no-results" class="hidden text-center py-12">
          <p class="text-xl text-gray-600 dark:text-gray-400">No blogs found matching your criteria.</p>
        </div>
      </div>
    )}
  </div>
</Layout>

<!-- Client-side filtering (progressive enhancement) -->
<script>
  function setupFilters() {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const sortFilter = document.getElementById('sort-filter') as HTMLSelectElement;
    const aiFilter = document.getElementById('ai-filter') as HTMLSelectElement;
    const blogsGrid = document.getElementById('blogs-grid') as HTMLElement;
    const noResults = document.getElementById('no-results') as HTMLElement;

    if (!blogsGrid) return;

    const blogCards = Array.from(blogsGrid.querySelectorAll('[data-blog]'));

    function filterAndSortBlogs() {
      const searchTerm = searchInput?.value.toLowerCase() || '';
      const selectedAiFilter = aiFilter?.value || '';
      const selectedSort = sortFilter?.value || 'newest';

      // Filter blogs
      let visibleBlogs = blogCards.filter((card) => {
        const blogData = JSON.parse((card as HTMLElement).getAttribute('data-blog') || '{}');
        const blogTitle = blogData.title || '';
        const isAiGenerated = blogData.isAi;

        const matchesSearch = !searchTerm || blogTitle.includes(searchTerm);
        const matchesAiFilter = !selectedAiFilter || 
          (selectedAiFilter === 'true' && isAiGenerated) || 
          (selectedAiFilter === 'false' && !isAiGenerated);

        return matchesSearch && matchesAiFilter;
      });

      // Sort blogs
      if (selectedSort === 'most_viewed') {
        visibleBlogs.sort((a, b) => {
          const aData = JSON.parse((a as HTMLElement).getAttribute('data-blog') || '{}');
          const bData = JSON.parse((b as HTMLElement).getAttribute('data-blog') || '{}');
          return (bData.views || 0) - (aData.views || 0);
        });
      } else if (selectedSort === 'oldest') {
        visibleBlogs.sort((a, b) => {
          const aData = JSON.parse((a as HTMLElement).getAttribute('data-blog') || '{}');
          const bData = JSON.parse((b as HTMLElement).getAttribute('data-blog') || '{}');
          return new Date(aData.date).getTime() - new Date(bData.date).getTime();
        });
      }
      // newest is default order from server

      // Update visibility
      blogCards.forEach(card => {
        (card as HTMLElement).style.display = 'none';
      });

      visibleBlogs.forEach(card => {
        (card as HTMLElement).style.display = 'block';
      });

      // Reorder in DOM
      visibleBlogs.forEach(card => {
        blogsGrid.appendChild(card);
      });

      // Show/hide no results
      if (noResults) {
        noResults.classList.toggle('hidden', visibleBlogs.length > 0);
      }
      blogsGrid.classList.toggle('hidden', visibleBlogs.length === 0);
    }

    // Setup event listeners
    if (searchInput) {
      let searchTimeout: any;
      searchInput.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(filterAndSortBlogs, 300);
      });
    }

    [sortFilter, aiFilter].forEach(filter => {
      if (filter) {
        filter.addEventListener('change', filterAndSortBlogs);
      }
    });
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFilters);
  } else {
    setupFilters();
  }
</script>
