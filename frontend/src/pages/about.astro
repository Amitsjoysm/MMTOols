---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About TechResona - Leading IT Solutions Provider in Pune',
  description: 'Learn about TechResona Pvt Ltd - your trusted technology partner for cloud solutions, web development, AI automation, and IT services in Pune, India.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About TechResona"
  >
    <Fragment slot="title">
      Empowering Businesses with <br />
      <span class="text-accent dark:text-white">Innovative Technology Solutions</span>
    </Fragment>

    <Fragment slot="subtitle">
      TechResona Pvt Ltd is a leading technology solutions provider based in Pune, India. Since our inception, 
      we've been dedicated to helping businesses transform digitally with cutting-edge cloud solutions, 
      web development, AI automation, and comprehensive IT services.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Our Impact in Numbers"
    stats={[
      { title: 'Years in Business', amount: '10+' },
      { title: 'Happy Clients', amount: '200+' },
      { title: 'Projects Completed', amount: '500+' },
      { title: 'Team Members', amount: '25+' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Our Core Services"
    subtitle="Comprehensive technology solutions designed to accelerate your business growth and digital transformation."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Cloud Solutions',
        description:
          'Expert Azure and AWS migration, cloud modernization, hybrid cloud setup, and 24/7 managed cloud services.',
        icon: 'tabler:cloud',
      },
      {
        title: 'Web Development',
        description:
          'Responsive websites, eCommerce platforms, Progressive Web Apps, and custom web applications built with modern technologies.',
        icon: 'tabler:world-www',
      },
      {
        title: 'AI & Automation',
        description:
          'Robotic Process Automation (RPA), workflow automation, and custom AI integrations to streamline business operations.',
        icon: 'tabler:robot',
      },
      {
        title: 'SEO Services',
        description:
          'Comprehensive SEO strategies including local SEO, technical audits, content marketing, and link building campaigns.',
        icon: 'tabler:seo',
      },
      {
        title: 'Microsoft 365 & G Suite',
        description:
          'Authorized reseller offering competitive licensing, complete deployment, migration services, and ongoing support.',
        icon: 'tabler:brand-office',
      },
      {
        title: 'IT Consulting',
        description:
          'Strategic technology consulting, digital transformation roadmaps, and IT infrastructure planning and optimization.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our Core Values"
    subtitle="The principles that guide every project we undertake and every relationship we build."
    items={[
      {
        title: 'Client Success First',
        description:
          'Your success is our primary goal. We measure our achievements by the value we create for your business.',
      },
      {
        title: 'Innovation & Excellence',
        description:
          'Continuously adopting the latest technologies and best practices to deliver solutions that give you a competitive edge.',
      },
      {
        title: 'Transparency & Trust',
        description:
          'Open communication, clear pricing, and honest advice. We build long-term partnerships based on trust and mutual respect.',
      },
      {
        title: 'Continuous Learning',
        description:
          'Staying ahead of technology trends through continuous learning, certifications, and professional development.',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Why Businesses Choose TechResona"
    subtitle="What sets us apart from other IT service providers."
    isReversed={true}
    items={[
      {
        title: 'Proven Expertise',
        description: 'Microsoft, AWS, and Google certified professionals with 10+ years of combined experience in enterprise IT.',
        icon: 'tabler:award',
      },
      {
        title: 'End-to-End Solutions',
        description:
          'From consultation to implementation and ongoing support, we handle everything so you can focus on your core business.',
        icon: 'tabler:checkup-list',
      },
      {
        title: 'Customer Satisfaction',
        description:
          '94% client retention rate and 200+ successful projects across various industries including finance, healthcare, education, and manufacturing.',
        icon: 'tabler:message-star',
      },
      {
        title: 'Local Presence, Global Standards',
        description:
          'Based in Pune with deep understanding of local market needs, while following international best practices and standards.',
        icon: 'tabler:world',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Our Technology Partnerships"
    tagline="Certified Partners"
    columns={4}
    items={[
      {
        title: 'Microsoft',
        description: 'Certified Partner',
        icon: 'tabler:brand-windows',
      },
      {
        title: 'Amazon AWS',
        description: 'Cloud Partner',
        icon: 'tabler:brand-aws',
      },
      {
        title: 'Google Cloud',
        description: 'Workspace Reseller',
        icon: 'tabler:brand-google',
      },
      {
        title: 'WordPress',
        description: 'Expert Developer',
        icon: 'tabler:brand-wordpress',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Visit Our Office"
    tagline="Get in Touch"
    columns={2}
    items={[
      {
        title: 'Address',
        description:
          'TechResona Pvt Ltd<br>Kharadi, Pune 411047<br>Maharashtra, India',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Contact Information',
        description:
          'Email: info@techresona.com<br>Phone: +91 7517402788<br>LinkedIn: <a href="https://www.linkedin.com/company/techresona-services/" target="_blank" class="text-blue-600 underline">techresona-services</a>',
        icon: 'tabler:phone',
      },
    ]}
  />
</Layout>
