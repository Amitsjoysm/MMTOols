---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'About MarketMindAI',
  description: 'Learn about MarketMindAI - your trusted directory for discovering and comparing AI tools and business solutions.',
};
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
        About MarketMindAI
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Your comprehensive directory for discovering, comparing, and reviewing AI tools and business solutions.
      </p>
    </div>

    <!-- Mission Section -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8 md:p-12 mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Our Mission</h2>
      <p class="text-lg text-gray-700 dark:text-gray-300 mb-4">
        At MarketMindAI, we believe that finding the right tools shouldn't be overwhelming. Our mission is to simplify the process of discovering, evaluating, and choosing AI tools and business solutions.
      </p>
      <p class="text-lg text-gray-700 dark:text-gray-300">
        We provide comprehensive, unbiased information to help businesses and individuals make informed decisions about the tools they use every day.
      </p>
    </div>

    <!-- What We Offer -->
    <div class="mb-16">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white text-center mb-10">What We Offer</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
          <div class="text-blue-600 dark:text-blue-400 mb-4">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Comprehensive Directory</h3>
          <p class="text-gray-700 dark:text-gray-300">
            Access hundreds of carefully curated tools across multiple categories, all in one place.
          </p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
          <div class="text-blue-600 dark:text-blue-400 mb-4">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Detailed Comparisons</h3>
          <p class="text-gray-700 dark:text-gray-300">
            Compare tools side by side with detailed feature breakdowns, pricing, and user reviews.
          </p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
          <div class="text-blue-600 dark:text-blue-400 mb-4">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Expert Insights</h3>
          <p class="text-gray-700 dark:text-gray-300">
            Get expert analysis, real user reviews, and practical recommendations for each tool.
          </p>
        </div>
      </div>
    </div>

    <!-- Our Values -->
    <div class="bg-blue-50 dark:bg-gray-900 rounded-lg p-8 md:p-12 mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white text-center mb-10">Our Values</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">🎯 Transparency</h3>
          <p class="text-gray-700 dark:text-gray-300">
            We provide honest, unbiased reviews and comparisons. No hidden agendas, just facts.
          </p>
        </div>
        <div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">🔍 Quality</h3>
          <p class="text-gray-700 dark:text-gray-300">
            Every tool in our directory is carefully vetted to ensure we only list quality solutions.
          </p>
        </div>
        <div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">🤝 Community</h3>
          <p class="text-gray-700 dark:text-gray-300">
            We value user feedback and build our platform based on what our community needs.
          </p>
        </div>
        <div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">📈 Innovation</h3>
          <p class="text-gray-700 dark:text-gray-300">
            We constantly evolve our platform to provide the best tool discovery experience.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Call to Action -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Browse Tools',
        href: '/tools',
      },
      {
        text: 'Contact Us',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="title">
      Join Our Growing Community
    </Fragment>

    <Fragment slot="subtitle">
      Discover the tools that will transform your business. Start exploring today!
    </Fragment>
  </CallToAction>
</Layout>
