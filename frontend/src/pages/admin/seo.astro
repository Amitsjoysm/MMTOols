---
import AdminLayout from '~/layouts/AdminLayout.astro';

const metadata = {
  title: 'SEO Management - Admin',
};
---

<AdminLayout metadata={metadata}>
  <div id="seo-management" class="space-y-6">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">SEO Management</h2>
    </div>

    <!-- SEO Overview Stats -->
    <div id="seo-overview" class="grid grid-cols-1 md:grid-cols-4 gap-6">
      <!-- Stats will be loaded here -->
    </div>

    <!-- SEO Actions -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">SEO Tools</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <button
          id="generate-json-ld-btn"
          class="px-4 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium text-left"
          data-testid="generate-json-ld-btn"
        >
          <div class="font-bold">Generate JSON-LD for All Content</div>
          <div class="text-sm opacity-90">Add structured data to tools and blogs</div>
        </button>
        
        <button
          id="analyze-issues-btn"
          class="px-4 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors font-medium text-left"
        >
          <div class="font-bold">Analyze SEO Issues</div>
          <div class="text-sm opacity-90">Find and fix SEO problems</div>
        </button>
      </div>
    </div>

    <!-- SEO Issues Section -->
    <div id="seo-issues-section" class="hidden">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold text-gray-900 dark:text-white">SEO Issues</h3>
          <select
            id="severity-filter"
            class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All Severity</option>
            <option value="critical">Critical</option>
            <option value="high">High</option>
            <option value="medium">Medium</option>
            <option value="low">Low</option>
          </select>
        </div>
        
        <!-- Issues Summary -->
        <div id="issues-summary" class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          <!-- Summary will be rendered here -->
        </div>
        
        <!-- Issues List -->
        <div id="issues-list" class="space-y-4">
          <!-- Issues will be rendered here -->
        </div>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loading" class="hidden text-center py-12">
      <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      <p class="mt-4 text-gray-600 dark:text-gray-400">Processing...</p>
    </div>
  </div>
</AdminLayout>

<script>
  import { superAdminApi } from '~/utils/api';
  import { requireAdmin } from '~/utils/auth';

  requireAdmin();

  let allIssues: any[] = [];

  async function init() {
    await loadSEOOverview();
    setupEventListeners();
  }

  async function loadSEOOverview() {
    try {
      const overview = await superAdminApi.seo.getOverview();
      const overviewDiv = document.getElementById('seo-overview')!;
      
      overviewDiv.innerHTML = `
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6" data-testid="seo-health-score">
          <div class="text-3xl font-bold ${overview.overview.seo_health_score >= 80 ? 'text-green-600 dark:text-green-400' : overview.overview.seo_health_score >= 60 ? 'text-yellow-600 dark:text-yellow-400' : 'text-red-600 dark:text-red-400'}">
            ${overview.overview.seo_health_score.toFixed(1)}%
          </div>
          <div class="text-sm text-gray-600 dark:text-gray-400 mt-1">SEO Health Score</div>
        </div>
        
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
          <div class="text-3xl font-bold text-blue-600 dark:text-blue-400">${overview.overview.seo_optimized}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400 mt-1">Pages Optimized</div>
          <div class="text-xs text-gray-500 mt-1">of ${overview.overview.total_pages} total</div>
        </div>
        
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
          <div class="text-3xl font-bold text-purple-600 dark:text-purple-400">${overview.tools.with_seo}/${overview.tools.total}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400 mt-1">Tools with SEO</div>
          <div class="text-xs text-gray-500 mt-1">${overview.tools.completion_rate}% complete</div>
        </div>
        
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
          <div class="text-3xl font-bold text-green-600 dark:text-green-400">${overview.blogs.with_seo}/${overview.blogs.total}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400 mt-1">Blogs with SEO</div>
          <div class="text-xs text-gray-500 mt-1">${overview.blogs.completion_rate}% complete</div>
        </div>
      `;
    } catch (error) {
      console.error('Error loading SEO overview:', error);
    }
  }

  async function generateJsonLd() {
    const loading = document.getElementById('loading')!;
    loading.classList.remove('hidden');

    try {
      await superAdminApi.seo.generateJsonLd('all', 1000);
      alert('JSON-LD generated successfully for all content!');
      await loadSEOOverview();
    } catch (error: any) {
      console.error('Error generating JSON-LD:', error);
      alert('Failed to generate JSON-LD: ' + (error.message || 'Unknown error'));
    } finally {
      loading.classList.add('hidden');
    }
  }

  async function analyzeSEOIssues() {
    const loading = document.getElementById('loading')!;
    const issuesSection = document.getElementById('seo-issues-section')!;
    
    loading.classList.remove('hidden');

    try {
      const result = await superAdminApi.seo.getIssues();
      allIssues = result.issues || [];
      
      // Render issues summary
      const issuesSummary = document.getElementById('issues-summary')!;
      issuesSummary.innerHTML = `
        <div class="p-3 bg-red-50 dark:bg-red-900/20 rounded">
          <div class="text-2xl font-bold text-red-600 dark:text-red-400">${result.summary.critical || 0}</div>
          <div class="text-xs text-gray-600 dark:text-gray-400">Critical</div>
        </div>
        <div class="p-3 bg-orange-50 dark:bg-orange-900/20 rounded">
          <div class="text-2xl font-bold text-orange-600 dark:text-orange-400">${result.summary.high || 0}</div>
          <div class="text-xs text-gray-600 dark:text-gray-400">High</div>
        </div>
        <div class="p-3 bg-yellow-50 dark:bg-yellow-900/20 rounded">
          <div class="text-2xl font-bold text-yellow-600 dark:text-yellow-400">${result.summary.medium || 0}</div>
          <div class="text-xs text-gray-600 dark:text-gray-400">Medium</div>
        </div>
        <div class="p-3 bg-blue-50 dark:bg-blue-900/20 rounded">
          <div class="text-2xl font-bold text-blue-600 dark:text-blue-400">${result.summary.low || 0}</div>
          <div class="text-xs text-gray-600 dark:text-gray-400">Low</div>
        </div>
      `;
      
      renderIssues(allIssues);
      issuesSection.classList.remove('hidden');
    } catch (error: any) {
      console.error('Error analyzing SEO issues:', error);
      alert('Failed to analyze SEO issues: ' + (error.message || 'Unknown error'));
    } finally {
      loading.classList.add('hidden');
    }
  }

  function renderIssues(issues: any[]) {
    const issuesList = document.getElementById('issues-list')!;
    
    if (issues.length === 0) {
      issuesList.innerHTML = '<p class="text-center text-gray-500 dark:text-gray-400 py-8">No issues found! Your SEO is in great shape.</p>';
      return;
    }
    
    issuesList.innerHTML = issues.map(issue => `
      <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
        <div class="flex items-start justify-between mb-2">
          <div class="flex-1">
            <div class="flex items-center space-x-2 mb-2">
              <h4 class="font-bold text-gray-900 dark:text-white">${issue.title}</h4>
              <span class="px-2 py-1 rounded text-xs font-medium ${
                issue.severity === 'critical' ? 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200' :
                issue.severity === 'high' ? 'bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200' :
                issue.severity === 'medium' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200' :
                'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200'
              }">
                ${issue.severity}
              </span>
              <span class="px-2 py-1 rounded text-xs bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200">
                ${issue.page_type}
              </span>
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-2">${issue.page_path}</div>
          </div>
        </div>
        
        <div class="mb-3">
          <div class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Issues:</div>
          <ul class="list-disc list-inside text-sm text-gray-600 dark:text-gray-400">
            ${issue.issues.map((i: string) => `<li>${i}</li>`).join('')}
          </ul>
        </div>
        
        <div>
          <div class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Recommendations:</div>
          <ul class="list-disc list-inside text-sm text-green-600 dark:text-green-400">
            ${issue.recommendations.map((r: string) => `<li>${r}</li>`).join('')}
          </ul>
        </div>
      </div>
    `).join('');
  }

  function setupEventListeners() {
    document.getElementById('generate-json-ld-btn')!.addEventListener('click', generateJsonLd);
    document.getElementById('analyze-issues-btn')!.addEventListener('click', analyzeSEOIssues);
    
    document.getElementById('severity-filter')!.addEventListener('change', (e) => {
      const severity = (e.target as HTMLSelectElement).value;
      const filtered = severity ? allIssues.filter(issue => issue.severity === severity) : allIssues;
      renderIssues(filtered);
    });
  }

  init();
</script>