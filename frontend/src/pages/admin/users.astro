---
import AdminLayout from '~/layouts/AdminLayout.astro';

const metadata = {
  title: 'Users Management - SuperAdmin',
};
---

<AdminLayout metadata={metadata}>
  <div id="users-management" class="space-y-6">

    <!-- Header -->
    <div class="flex items-center justify-between flex-wrap gap-4">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Users Management</h2>
      <span id="total-count" class="text-sm text-gray-500 dark:text-gray-400"></span>
    </div>

    <!-- Filters -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-4">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <input type="text" id="search-input" placeholder="Search by name, email, username..."
          class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm" />
        <select id="role-filter"
          class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm">
          <option value="">All Roles</option>
          <option value="user">User</option>
          <option value="admin">Admin</option>
          <option value="superadmin">Super Admin</option>
        </select>
        <button id="reset-filters-btn"
          class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors text-sm">
          Reset Filters
        </button>
      </div>
    </div>

    <!-- Loading -->
    <div id="loading" class="text-center py-12">
      <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      <p class="mt-4 text-gray-600 dark:text-gray-400">Loading users...</p>
    </div>

    <!-- Users Table (desktop) -->
    <div id="users-table-container" class="hidden bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-900">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">User</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Email</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Role</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Joined</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody id="users-tbody" class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <div id="pagination" class="hidden flex items-center justify-between flex-wrap gap-2">
      <div class="text-sm text-gray-700 dark:text-gray-300">
        Showing <span id="page-info"></span>
      </div>
      <div class="flex space-x-2">
        <button id="prev-btn" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 disabled:opacity-50 disabled:cursor-not-allowed text-sm">
          Previous
        </button>
        <button id="next-btn" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 disabled:opacity-50 disabled:cursor-not-allowed text-sm">
          Next
        </button>
      </div>
    </div>

    <!-- Role Change Modal -->
    <div id="role-modal" class="hidden fixed inset-0 bg-black bg-opacity-60 z-50 flex items-center justify-center p-4">
      <div class="bg-white dark:bg-gray-800 rounded-xl shadow-2xl w-full max-w-md">
        <div class="p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white">Change User Role</h3>
            <button onclick="document.getElementById('role-modal').classList.add('hidden')"
              class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>

          <div class="mb-6 p-4 bg-gray-50 dark:bg-gray-700 rounded-lg">
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Changing role for:</p>
            <p id="modal-username" class="font-semibold text-gray-900 dark:text-white"></p>
            <p id="modal-email" class="text-sm text-gray-500 dark:text-gray-400"></p>
          </div>

          <input type="hidden" id="modal-user-id" />
          <input type="hidden" id="modal-current-role" />

          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Select New Role</label>
            <div class="space-y-3">
              <label class="flex items-start p-3 border-2 rounded-lg cursor-pointer transition-all has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 dark:has-[:checked]:bg-blue-900/30 border-gray-200 dark:border-gray-600 hover:border-blue-300">
                <input type="radio" name="new-role" value="user" class="mt-1 mr-3 text-blue-600" />
                <div>
                  <span class="font-medium text-gray-900 dark:text-white">User</span>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Basic access - can submit tools, write reviews, comment</p>
                </div>
              </label>
              <label class="flex items-start p-3 border-2 rounded-lg cursor-pointer transition-all has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 dark:has-[:checked]:bg-blue-900/30 border-gray-200 dark:border-gray-600 hover:border-blue-300">
                <input type="radio" name="new-role" value="admin" class="mt-1 mr-3 text-blue-600" />
                <div>
                  <span class="font-medium text-gray-900 dark:text-white">Admin</span>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Manage tools, blogs, and content. Cannot manage users or system settings</p>
                </div>
              </label>
              <label class="flex items-start p-3 border-2 rounded-lg cursor-pointer transition-all has-[:checked]:border-purple-500 has-[:checked]:bg-purple-50 dark:has-[:checked]:bg-purple-900/30 border-gray-200 dark:border-gray-600 hover:border-purple-300">
                <input type="radio" name="new-role" value="superadmin" class="mt-1 mr-3 text-purple-600" />
                <div>
                  <span class="font-medium text-gray-900 dark:text-white">Super Admin</span>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Full access - manage all content, users, roles and system settings</p>
                </div>
              </label>
            </div>
          </div>

          <div id="role-warning" class="hidden mb-4 p-3 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-700 rounded-lg">
            <p class="text-sm text-yellow-800 dark:text-yellow-300 font-medium">⚠️ Warning</p>
            <p id="role-warning-text" class="text-sm text-yellow-700 dark:text-yellow-400 mt-1"></p>
          </div>

          <div class="flex gap-3 justify-end">
            <button onclick="document.getElementById('role-modal').classList.add('hidden')"
              class="px-4 py-2 text-sm bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600">
              Cancel
            </button>
            <button id="confirm-role-btn"
              class="px-6 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium disabled:opacity-50">
              Save Role
            </button>
          </div>
        </div>
      </div>
    </div>

  </div>
</AdminLayout>

<script>
  import { superAdminApi } from '~/utils/api';
  import { requireAdmin } from '~/utils/auth';

  requireAdmin();

  let currentSkip = 0;
  const limit = 20;

  // ── Role badge helpers ──────────────────────────────────────────────────
  function roleBadge(role: string): string {
    const map: Record<string, string> = {
      superadmin: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200',
      admin: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
      user: 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200',
    };
    return map[role] || map.user;
  }

  function statusBadge(active: boolean): string {
    return active
      ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
      : 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200';
  }

  // ── Load users ──────────────────────────────────────────────────────────
  async function loadUsers() {
    const loading = document.getElementById('loading')!;
    const tableContainer = document.getElementById('users-table-container')!;
    const tbody = document.getElementById('users-tbody')!;

    loading.classList.remove('hidden');
    tableContainer.classList.add('hidden');

    try {
      const searchInput = (document.getElementById('search-input') as HTMLInputElement).value.trim();
      const roleFilter  = (document.getElementById('role-filter') as HTMLSelectElement).value;
      const params: any = { skip: currentSkip, limit };
      if (searchInput) params.search = searchInput;
      if (roleFilter)  params.role   = roleFilter;

      const users = await superAdminApi.users.getAll(params);

      tbody.innerHTML = users.map((user: any) => `
        <tr data-user-id="${user.id}" class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
          <td class="px-6 py-4">
            <div class="flex items-center space-x-3 min-w-0">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center text-white font-semibold text-sm">
                ${(user.full_name || user.username || '?').charAt(0).toUpperCase()}
              </div>
              <div class="min-w-0">
                <div class="font-medium text-gray-900 dark:text-white truncate">${user.full_name || user.username}</div>
                <div class="text-xs text-gray-500 dark:text-gray-400">@${user.username}</div>
              </div>
            </div>
          </td>
          <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 max-w-[180px] truncate">${user.email}</td>
          <td class="px-6 py-4">
            <span class="px-3 py-1 rounded-full text-xs font-medium ${roleBadge(user.role)}" data-role-badge="${user.id}">
              ${user.role}
            </span>
          </td>
          <td class="px-6 py-4">
            <span class="px-3 py-1 rounded-full text-xs font-medium ${statusBadge(user.is_active)}">
              ${user.is_active ? 'Active' : 'Inactive'}
            </span>
          </td>
          <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap">
            ${new Date(user.created_at).toLocaleDateString()}
          </td>
          <td class="px-6 py-4 text-right">
            <div class="flex items-center justify-end gap-2 flex-wrap">
              <button
                onclick="window.openRoleModal('${user.id}', '${user.role}', '${(user.full_name || user.username).replace(/'/g, "\\'")}', '${user.email}')"
                class="px-3 py-1.5 text-xs font-medium bg-indigo-100 text-indigo-700 dark:bg-indigo-900 dark:text-indigo-300 rounded-lg hover:bg-indigo-200 dark:hover:bg-indigo-800 transition-colors whitespace-nowrap"
                ${user.role === 'superadmin' ? 'title="Cannot demote last superadmin"' : ''}>
                Change Role
              </button>
              <button
                onclick="window.toggleUserStatus('${user.id}', ${user.is_active})"
                class="px-3 py-1.5 text-xs font-medium ${user.is_active ? 'bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300 hover:bg-red-200' : 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300 hover:bg-green-200'} rounded-lg transition-colors whitespace-nowrap">
                ${user.is_active ? 'Deactivate' : 'Activate'}
              </button>
            </div>
          </td>
        </tr>
      `).join('');

      loading.classList.add('hidden');
      tableContainer.classList.remove('hidden');
      document.getElementById('pagination')!.classList.remove('hidden');
      updatePaginationInfo(users.length);

      const total = document.getElementById('total-count')!;
      if (currentSkip === 0 && users.length < limit) {
        total.textContent = `${users.length} user${users.length !== 1 ? 's' : ''}`;
      }
    } catch (error) {
      console.error('Error loading users:', error);
      loading.classList.add('hidden');
    }
  }

  function updatePaginationInfo(count: number) {
    const pageInfo = document.getElementById('page-info')!;
    const start = currentSkip + 1;
    const end   = currentSkip + count;
    pageInfo.textContent = `${start}–${end}`;
    (document.getElementById('prev-btn') as HTMLButtonElement).disabled = currentSkip === 0;
    (document.getElementById('next-btn') as HTMLButtonElement).disabled = count < limit;
  }

  // ── Toggle user status ──────────────────────────────────────────────────
  (window as any).toggleUserStatus = async function(userId: string, currentStatus: boolean) {
    if (!confirm(`Are you sure you want to ${currentStatus ? 'deactivate' : 'activate'} this user?`)) return;
    try {
      await superAdminApi.users.update(userId, { is_active: !currentStatus });
      showToast(`User ${currentStatus ? 'deactivated' : 'activated'} successfully.`, 'success');
      loadUsers();
    } catch (error: any) {
      showToast('Failed to update user: ' + (error.message || 'Unknown error'), 'error');
    }
  };

  // ── Role modal ──────────────────────────────────────────────────────────
  (window as any).openRoleModal = function(userId: string, currentRole: string, name: string, email: string) {
    (document.getElementById('modal-user-id') as HTMLInputElement).value = userId;
    (document.getElementById('modal-current-role') as HTMLInputElement).value = currentRole;
    document.getElementById('modal-username')!.textContent = name;
    document.getElementById('modal-email')!.textContent = email;

    // Pre-select current role
    const radios = document.querySelectorAll<HTMLInputElement>('input[name="new-role"]');
    radios.forEach(r => { r.checked = r.value === currentRole; });

    document.getElementById('role-warning')!.classList.add('hidden');
    document.getElementById('role-modal')!.classList.remove('hidden');
  };

  // Show warning when superadmin is selected
  document.querySelectorAll<HTMLInputElement>('input[name="new-role"]').forEach(radio => {
    radio.addEventListener('change', () => {
      const warn = document.getElementById('role-warning')!;
      const warnText = document.getElementById('role-warning-text')!;
      if (radio.value === 'superadmin') {
        warnText.textContent = 'This user will have FULL access to all admin features including user management and system settings.';
        warn.classList.remove('hidden');
      } else if (radio.value === 'user') {
        const currentRole = (document.getElementById('modal-current-role') as HTMLInputElement).value;
        if (currentRole === 'superadmin' || currentRole === 'admin') {
          warnText.textContent = 'This will remove all admin privileges from this user.';
          warn.classList.remove('hidden');
        } else {
          warn.classList.add('hidden');
        }
      } else {
        warn.classList.add('hidden');
      }
    });
  });

  // Confirm role change
  document.getElementById('confirm-role-btn')!.addEventListener('click', async () => {
    const userId  = (document.getElementById('modal-user-id') as HTMLInputElement).value;
    const newRole = (document.querySelector<HTMLInputElement>('input[name="new-role"]:checked'))?.value;
    const currentRole = (document.getElementById('modal-current-role') as HTMLInputElement).value;

    if (!newRole) {
      showToast('Please select a role.', 'error');
      return;
    }

    if (newRole === currentRole) {
      document.getElementById('role-modal')!.classList.add('hidden');
      return;
    }

    const btn = document.getElementById('confirm-role-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Saving…';

    try {
      await superAdminApi.users.update(userId, { role: newRole });
      document.getElementById('role-modal')!.classList.add('hidden');
      showToast(`Role updated to "${newRole}" successfully!`, 'success');
      loadUsers();
    } catch (error: any) {
      showToast('Failed to update role: ' + (error.message || 'Unknown error'), 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Save Role';
    }
  });

  // Close modal on backdrop click
  document.getElementById('role-modal')!.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
      (e.currentTarget as HTMLElement).classList.add('hidden');
    }
  });

  // ── Event listeners ─────────────────────────────────────────────────────
  let searchTimeout: ReturnType<typeof setTimeout>;
  document.getElementById('search-input')!.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => { currentSkip = 0; loadUsers(); }, 500);
  });
  document.getElementById('role-filter')!.addEventListener('change', () => { currentSkip = 0; loadUsers(); });
  document.getElementById('reset-filters-btn')!.addEventListener('click', () => {
    (document.getElementById('search-input') as HTMLInputElement).value = '';
    (document.getElementById('role-filter') as HTMLSelectElement).value = '';
    currentSkip = 0;
    loadUsers();
  });
  document.getElementById('prev-btn')!.addEventListener('click', () => {
    if (currentSkip > 0) { currentSkip -= limit; loadUsers(); }
  });
  document.getElementById('next-btn')!.addEventListener('click', () => { currentSkip += limit; loadUsers(); });

  // ── Toast ───────────────────────────────────────────────────────────────
  function showToast(message: string, type: 'success' | 'error') {
    const existing = document.getElementById('toast-notification');
    if (existing) existing.remove();

    const toast = document.createElement('div');
    toast.id = 'toast-notification';
    toast.className = `fixed bottom-6 right-6 z-[9999] px-5 py-3 rounded-xl shadow-xl text-white text-sm font-medium transition-all transform translate-y-0 ${
      type === 'success' ? 'bg-green-600' : 'bg-red-600'
    }`;
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 4000);
  }

  loadUsers();
</script>
