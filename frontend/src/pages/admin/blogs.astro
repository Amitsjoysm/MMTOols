---
import AdminLayout from '~/layouts/AdminLayout.astro';

const metadata = {
  title: 'Blogs Management - Admin',
};
---

<AdminLayout metadata={metadata}>
  <div id="blogs-management" class="space-y-6">
    <!-- Header with Actions -->
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Blogs Management</h2>
      <button
        id="create-blog-btn"
        class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
        data-testid="create-blog-btn"
      >
        + Add New Blog
      </button>
    </div>

    <!-- Filters -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-4">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <input
          type="text"
          id="search-input"
          placeholder="Search blogs..."
          class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
        />
        <select
          id="status-filter"
          class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
        >
          <option value="">All Status</option>
          <option value="draft">Draft</option>
          <option value="published">Published</option>
          <option value="archived">Archived</option>
        </select>
        <select
          id="author-filter"
          class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
        >
          <option value="">All Authors</option>
        </select>
        <button
          id="reset-filters-btn"
          class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
        >
          Reset Filters
        </button>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loading" class="text-center py-12">
      <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      <p class="mt-4 text-gray-600 dark:text-gray-400">Loading blogs...</p>
    </div>

    <!-- Blogs Table -->
    <div id="blogs-table-container" class="hidden bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-900">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Title</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Author</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Stats</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Date</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody id="blogs-tbody" class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
            <!-- Blogs will be rendered here -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <div id="pagination" class="hidden flex items-center justify-between">
      <div class="text-sm text-gray-700 dark:text-gray-300">
        Showing <span id="page-info"></span>
      </div>
      <div class="flex space-x-2">
        <button id="prev-btn" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 disabled:opacity-50 disabled:cursor-not-allowed">
          Previous
        </button>
        <button id="next-btn" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 disabled:opacity-50 disabled:cursor-not-allowed">
          Next
        </button>
      </div>
    </div>
  </div>

  <!-- Create/Edit Blog Modal -->
  <div id="blog-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
      <div class="p-6">
        <div class="flex items-center justify-between mb-6">
          <h3 id="modal-title" class="text-2xl font-bold text-gray-900 dark:text-white">Add New Blog</h3>
          <button id="close-modal" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <form id="blog-form" class="space-y-6">
          <input type="hidden" id="blog-id" />
          
          <!-- Title -->
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Title *</label>
            <input type="text" id="blog-title" required class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
          </div>

          <!-- Excerpt -->
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Excerpt</label>
            <textarea id="blog-excerpt" rows="2" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"></textarea>
          </div>

          <!-- Content -->
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Content *</label>
            <textarea id="blog-content" required rows="10" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 font-mono text-sm"></textarea>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Author -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Author *</label>
              <select id="blog-author" required class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                <option value="">Select Author</option>
              </select>
            </div>

            <!-- Status -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Status *</label>
              <select id="blog-status" required class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                <option value="draft">Draft</option>
                <option value="published">Published</option>
                <option value="archived">Archived</option>
              </select>
            </div>

            <!-- Featured Image URL -->
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Featured Image URL</label>
              <input type="url" id="blog-image" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
            </div>

            <!-- Tags -->
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Tags (comma-separated)</label>
              <input type="text" id="blog-tags" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" placeholder="ai, technology, tutorial" />
            </div>
          </div>

          <div class="flex items-center justify-end space-x-4 pt-4 border-t border-gray-200 dark:border-gray-700">
            <button type="button" id="cancel-btn" class="px-6 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600">
              Cancel
            </button>
            <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" data-testid="save-blog-btn">
              Save Blog
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { superAdminApi } from '~/utils/api';
  import { requireAdmin, getUserData } from '~/utils/auth';

  // Check authentication
  requireAdmin();

  let currentSkip = 0;
  const limit = 20;
  let allAuthors: any[] = [];
  let editingBlogId: string | null = null;

  // Initialize
  async function init() {
    await loadAuthors();
    await loadBlogs();
    setupEventListeners();
  }

  async function loadAuthors() {
    try {
      allAuthors = await superAdminApi.users.getAll({ limit: 1000 });
      
      // Populate author filters
      const authorFilter = document.getElementById('author-filter') as HTMLSelectElement;
      const blogAuthor = document.getElementById('blog-author') as HTMLSelectElement;
      
      allAuthors.forEach(author => {
        const filterOption = document.createElement('option');
        filterOption.value = author.id;
        filterOption.textContent = author.full_name || author.username;
        authorFilter.appendChild(filterOption);

        const formOption = document.createElement('option');
        formOption.value = author.id;
        formOption.textContent = author.full_name || author.username;
        blogAuthor.appendChild(formOption);
      });

      // Pre-select current user as author
      const currentUser = getCurrentUser();
      if (currentUser) {
        (document.getElementById('blog-author') as HTMLSelectElement).value = currentUser.id;
      }
    } catch (error) {
      console.error('Error loading authors:', error);
    }
  }

  async function loadBlogs() {
    const loading = document.getElementById('loading')!;
    const tableContainer = document.getElementById('blogs-table-container')!;
    const tbody = document.getElementById('blogs-tbody')!;
    
    loading.classList.remove('hidden');
    tableContainer.classList.add('hidden');

    try {
      const searchInput = (document.getElementById('search-input') as HTMLInputElement).value;
      const statusFilter = (document.getElementById('status-filter') as HTMLSelectElement).value;
      const authorFilter = (document.getElementById('author-filter') as HTMLSelectElement).value;

      const params: any = {
        skip: currentSkip,
        limit: limit,
      };

      if (searchInput) params.search = searchInput;
      if (statusFilter) params.status = statusFilter;
      if (authorFilter) params.author_id = authorFilter;

      const blogs = await superAdminApi.blogs.getAll(params);

      tbody.innerHTML = blogs.map((blog: any) => `
        <tr data-testid="blog-row-${blog.id}">
          <td class="px-6 py-4">
            <div class="font-medium text-gray-900 dark:text-white">${blog.title}</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">${blog.slug}</div>
          </td>
          <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300">
            ${blog.author_name || 'Unknown'}
          </td>
          <td class="px-6 py-4">
            <span class="px-3 py-1 rounded-full text-xs font-medium ${
              blog.status === 'published' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' :
              blog.status === 'draft' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200' :
              'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200'
            }">
              ${blog.status}
            </span>
          </td>
          <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300">
            <div>${blog.view_count} views</div>
            <div>${blog.like_count} likes</div>
          </td>
          <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300">
            ${new Date(blog.created_at).toLocaleDateString()}
          </td>
          <td class="px-6 py-4 text-right space-x-2">
            <button onclick="window.editBlog('${blog.id}')" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300" data-testid="edit-blog-${blog.id}">
              Edit
            </button>
            ${blog.status !== 'published' ? `
              <button onclick="window.publishBlog('${blog.id}')" class="text-green-600 hover:text-green-800 dark:text-green-400 dark:hover:text-green-300">
                Publish
              </button>
            ` : `
              <button onclick="window.unpublishBlog('${blog.id}')" class="text-orange-600 hover:text-orange-800 dark:text-orange-400 dark:hover:text-orange-300">
                Unpublish
              </button>
            `}
            <button onclick="window.deleteBlog('${blog.id}', '${blog.title.replace(/'/g, "\\'")}')" class="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300" data-testid="delete-blog-${blog.id}">
              Delete
            </button>
          </td>
        </tr>
      `).join('');

      loading.classList.add('hidden');
      tableContainer.classList.remove('hidden');
      document.getElementById('pagination')!.classList.remove('hidden');
      
      updatePaginationInfo(blogs.length);
    } catch (error) {
      console.error('Error loading blogs:', error);
      loading.classList.add('hidden');
    }
  }

  function updatePaginationInfo(count: number) {
    const pageInfo = document.getElementById('page-info')!;
    const start = currentSkip + 1;
    const end = currentSkip + count;
    pageInfo.textContent = `${start}-${end}`;

    const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
    
    prevBtn.disabled = currentSkip === 0;
    nextBtn.disabled = count < limit;
  }

  function setupEventListeners() {
    // Search with debounce
    let searchTimeout: any;
    document.getElementById('search-input')!.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        currentSkip = 0;
        loadBlogs();
      }, 500);
    });

    // Filter changes
    document.getElementById('status-filter')!.addEventListener('change', () => {
      currentSkip = 0;
      loadBlogs();
    });
    document.getElementById('author-filter')!.addEventListener('change', () => {
      currentSkip = 0;
      loadBlogs();
    });

    // Reset filters
    document.getElementById('reset-filters-btn')!.addEventListener('click', () => {
      (document.getElementById('search-input') as HTMLInputElement).value = '';
      (document.getElementById('status-filter') as HTMLSelectElement).value = '';
      (document.getElementById('author-filter') as HTMLSelectElement).value = '';
      currentSkip = 0;
      loadBlogs();
    });

    // Pagination
    document.getElementById('prev-btn')!.addEventListener('click', () => {
      if (currentSkip > 0) {
        currentSkip -= limit;
        loadBlogs();
      }
    });
    document.getElementById('next-btn')!.addEventListener('click', () => {
      currentSkip += limit;
      loadBlogs();
    });

    // Create blog button
    document.getElementById('create-blog-btn')!.addEventListener('click', () => {
      openBlogModal();
    });

    // Modal close buttons
    document.getElementById('close-modal')!.addEventListener('click', closeBlogModal);
    document.getElementById('cancel-btn')!.addEventListener('click', closeBlogModal);

    // Blog form submit
    document.getElementById('blog-form')!.addEventListener('submit', handleBlogSubmit);
  }

  function openBlogModal(blog?: any) {
    const modal = document.getElementById('blog-modal')!;
    const modalTitle = document.getElementById('modal-title')!;
    const form = document.getElementById('blog-form') as HTMLFormElement;
    
    form.reset();
    editingBlogId = blog?.id || null;
    modalTitle.textContent = blog ? 'Edit Blog' : 'Add New Blog';

    if (blog) {
      (document.getElementById('blog-id') as HTMLInputElement).value = blog.id;
      (document.getElementById('blog-title') as HTMLInputElement).value = blog.title;
      (document.getElementById('blog-excerpt') as HTMLTextAreaElement).value = blog.excerpt || '';
      (document.getElementById('blog-content') as HTMLTextAreaElement).value = blog.content;
      (document.getElementById('blog-author') as HTMLSelectElement).value = blog.author_id;
      (document.getElementById('blog-status') as HTMLSelectElement).value = blog.status;
      (document.getElementById('blog-image') as HTMLInputElement).value = blog.featured_image || '';
      (document.getElementById('blog-tags') as HTMLInputElement).value = blog.tags?.join(', ') || '';
    } else {
      // Pre-select current user as author for new blog
      const currentUser = getCurrentUser();
      if (currentUser) {
        (document.getElementById('blog-author') as HTMLSelectElement).value = currentUser.id;
      }
    }

    modal.classList.remove('hidden');
  }

  function closeBlogModal() {
    document.getElementById('blog-modal')!.classList.add('hidden');
    editingBlogId = null;
  }

  async function handleBlogSubmit(e: Event) {
    e.preventDefault();
    
    const submitBtn = (e.target as HTMLFormElement).querySelector('button[type=\"submit\"]') as HTMLButtonElement;
    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Saving...';

    try {
      const tagsInput = (document.getElementById('blog-tags') as HTMLInputElement).value;
      const tags = tagsInput ? tagsInput.split(',').map(t => t.trim()).filter(t => t) : [];

      const blogData = {
        title: (document.getElementById('blog-title') as HTMLInputElement).value,
        excerpt: (document.getElementById('blog-excerpt') as HTMLTextAreaElement).value,
        content: (document.getElementById('blog-content') as HTMLTextAreaElement).value,
        author_id: (document.getElementById('blog-author') as HTMLSelectElement).value,
        status: (document.getElementById('blog-status') as HTMLSelectElement).value,
        featured_image: (document.getElementById('blog-image') as HTMLInputElement).value,
        tags: tags
      };

      if (editingBlogId) {
        await superAdminApi.blogs.update(editingBlogId, blogData);
      } else {
        await superAdminApi.blogs.create(blogData);
      }

      closeBlogModal();
      loadBlogs();
      alert(editingBlogId ? 'Blog updated successfully!' : 'Blog created successfully!');
    } catch (error: any) {
      console.error('Error saving blog:', error);
      alert('Failed to save blog: ' + (error.message || 'Unknown error'));
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  }

  // Global functions for inline event handlers
  (window as any).editBlog = async function(blogId: string) {
    try {
      const blogs = await superAdminApi.blogs.getAll({ skip: 0, limit: 1000 });
      const blog = blogs.find((b: any) => b.id === blogId);
      if (blog) {
        openBlogModal(blog);
      }
    } catch (error) {
      console.error('Error loading blog:', error);
    }
  };

  (window as any).publishBlog = async function(blogId: string) {
    if (!confirm('Are you sure you want to publish this blog?')) {
      return;
    }

    try {
      await superAdminApi.blogs.publish(blogId);
      alert('Blog published successfully!');
      loadBlogs();
    } catch (error: any) {
      console.error('Error publishing blog:', error);
      alert('Failed to publish blog: ' + (error.message || 'Unknown error'));
    }
  };

  (window as any).unpublishBlog = async function(blogId: string) {
    if (!confirm('Are you sure you want to unpublish this blog?')) {
      return;
    }

    try {
      await superAdminApi.blogs.unpublish(blogId);
      alert('Blog unpublished successfully!');
      loadBlogs();
    } catch (error: any) {
      console.error('Error unpublishing blog:', error);
      alert('Failed to unpublish blog: ' + (error.message || 'Unknown error'));
    }
  };

  (window as any).deleteBlog = async function(blogId: string, blogTitle: string) {
    if (!confirm(`Are you sure you want to delete "${blogTitle}"? This action cannot be undone.`)) {
      return;
    }

    try {
      await superAdminApi.blogs.delete(blogId);
      alert('Blog deleted successfully!');
      loadBlogs();
    } catch (error: any) {
      console.error('Error deleting blog:', error);
      alert('Failed to delete blog: ' + (error.message || 'Unknown error'));
    }
  };

  // Initialize on page load
  init();
</script>
