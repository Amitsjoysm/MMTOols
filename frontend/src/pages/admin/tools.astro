---
import AdminLayout from '~/layouts/AdminLayout.astro';

const metadata = {
  title: 'Tools Management - Admin',
};
---

<AdminLayout metadata={metadata}>
  <div id="tools-management" class="space-y-6">
    <!-- Header with Actions -->
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Tools Management</h2>
      <div class="flex gap-3">
        <button
          id="assign-tools-btn"
          class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors font-medium"
          data-testid="assign-tools-btn"
        >
          👤 Assign Tools
        </button>
        <button
          id="bulk-upload-btn"
          class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-medium"
          data-testid="bulk-upload-btn"
        >
          📤 Bulk Upload
        </button>
        <button
          id="create-tool-btn"
          class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
          data-testid="create-tool-btn"
        >
          + Add New Tool
        </button>
      </div>
    </div>

    <!-- Filters -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-4">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <input
          type="text"
          id="search-input"
          placeholder="Search tools..."
          class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
        />
        <select
          id="category-filter"
          class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
        >
          <option value="">All Categories</option>
        </select>
        <select
          id="status-filter"
          class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
        >
          <option value="">All Status</option>
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>
        <button
          id="reset-filters-btn"
          class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
        >
          Reset Filters
        </button>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loading" class="text-center py-12">
      <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      <p class="mt-4 text-gray-600 dark:text-gray-400">Loading tools...</p>
    </div>

    <!-- Tools Table -->
    <div id="tools-table-container" class="hidden bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-900">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                <input type="checkbox" id="select-all-tools" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" title="Select All" />
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Tool</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Categories</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Pricing</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Stats</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody id="tools-tbody" class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
            <!-- Tools will be rendered here -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <div id="pagination" class="hidden flex items-center justify-between">
      <div class="text-sm text-gray-700 dark:text-gray-300">
        Showing <span id="page-info"></span>
      </div>
      <div class="flex space-x-2">
        <button id="prev-btn" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 disabled:opacity-50 disabled:cursor-not-allowed">
          Previous
        </button>
        <button id="next-btn" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 disabled:opacity-50 disabled:cursor-not-allowed">
          Next
        </button>
      </div>
    </div>
  </div>

  <!-- Create/Edit Tool Modal -->
  <div id="tool-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
      <div class="p-6">
        <div class="flex items-center justify-between mb-6">
          <h3 id="modal-title" class="text-2xl font-bold text-gray-900 dark:text-white">Add New Tool</h3>
          <button id="close-modal" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <form id="tool-form" class="space-y-6">
          <input type="hidden" id="tool-id" />
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Name -->
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Tool Name *</label>
              <input type="text" id="tool-name" required class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
            </div>

            <!-- URL -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Website URL</label>
              <input type="url" id="tool-url" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
            </div>

            <!-- Pricing Type -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Pricing Type *</label>
              <select id="tool-pricing" required class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                <option value="free">Free</option>
                <option value="freemium">Freemium</option>
                <option value="paid">Paid</option>
              </select>
            </div>

            <!-- Short Description -->
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Short Description</label>
              <input type="text" id="tool-short-desc" maxlength="200" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
            </div>

            <!-- Full Description -->
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Full Description *</label>
              <textarea id="tool-description" required rows="4" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"></textarea>
            </div>

            <!-- Logo URL -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Logo URL</label>
              <input type="url" id="tool-logo" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
            </div>

            <!-- Screenshot URL -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Screenshot URL</label>
              <input type="url" id="tool-screenshot" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
            </div>

            <!-- Categories -->
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Categories</label>
              <select id="tool-categories" multiple class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" size="5">
                <!-- Categories loaded dynamically -->
              </select>
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Hold Ctrl/Cmd to select multiple</p>
            </div>

            <!-- Active Status -->
            <div class="md:col-span-2">
              <label class="flex items-center space-x-2">
                <input type="checkbox" id="tool-active" checked class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Active (visible on website)</span>
              </label>
            </div>

            <!-- Featured -->
            <div class="md:col-span-2">
              <label class="flex items-center space-x-2">
                <input type="checkbox" id="tool-featured" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Featured Tool</span>
              </label>
            </div>

            <!-- ── SEO & LLM Fields ── -->
            <div class="md:col-span-2 border-t border-gray-200 dark:border-gray-700 pt-4">
              <h4 class="text-base font-semibold text-gray-800 dark:text-white mb-3">SEO & LLM Crawl Fields</h4>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Platform</label>
              <input type="text" id="tool-platform" placeholder="Web, Desktop, Mobile..." class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Free Trial</label>
              <select id="tool-free-trial" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                <option value="">Not specified</option>
                <option value="Available">Available</option>
                <option value="Not Available">Not Available</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Rating (0-5)</label>
              <input type="number" id="tool-rating" min="0" max="5" step="0.1" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Best For</label>
              <input type="text" id="tool-best-for" placeholder="What is this tool best for?" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
            </div>

            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">SEO Title</label>
              <input type="text" id="tool-seo-title" placeholder="SEO optimized title for search engines" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
            </div>

            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">SEO Description</label>
              <textarea id="tool-seo-description" rows="2" placeholder="150-160 character meta description" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"></textarea>
            </div>

            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">SEO Keywords</label>
              <input type="text" id="tool-seo-keywords" placeholder="keyword1, keyword2, keyword3" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
            </div>

            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">FAQs (JSON array — for LLM crawling & SEO)</label>
              <textarea id="tool-faqs" rows="5" placeholder='[{"question":"What is X?","answer":"X is..."}]' class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 font-mono text-xs"></textarea>
              <p class="mt-1 text-xs text-gray-500">JSON array of FAQ objects with question/answer keys. Used for Google FAQ rich results.</p>
            </div>

            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Alternatives (JSON array)</label>
              <textarea id="tool-alternatives" rows="3" placeholder='[{"name":"ToolName","rating":4.5}]' class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 font-mono text-xs"></textarea>
            </div>

            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Custom JSON-LD (override auto-generated structured data)</label>
              <textarea id="tool-json-ld" rows="6" placeholder='{"@context":"https://schema.org","@type":"SoftwareApplication",...}' class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 font-mono text-xs"></textarea>
              <p class="mt-1 text-xs text-gray-500">Advanced: Override the auto-generated JSON-LD. Leave blank to auto-generate.</p>
            </div>
          </div>

          <div class="flex items-center justify-end space-x-4 pt-4 border-t border-gray-200 dark:border-gray-700">
            <button type="button" id="cancel-btn" class="px-6 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600">
              Cancel
            </button>
            <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" data-testid="save-tool-btn">
              Save Tool
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Bulk Upload Modal -->
  <div id="bulk-upload-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-2xl w-full">
      <div class="p-6">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Bulk Upload Tools</h3>
          <button id="close-bulk-modal" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="space-y-6">
          <!-- Instructions -->
          <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4">
            <h4 class="font-semibold text-blue-900 dark:text-blue-100 mb-2">📋 Instructions</h4>
            <ol class="list-decimal list-inside text-sm text-blue-800 dark:text-blue-200 space-y-1">
              <li>Download the CSV template below</li>
              <li>Fill in your tools data following the template format</li>
              <li>Upload the completed CSV file</li>
            </ol>
          </div>

          <!-- Download Template Button -->
          <div class="flex gap-3">
            <button
              id="download-template-btn"
              class="flex-1 px-4 py-3 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors font-medium border-2 border-dashed border-gray-300 dark:border-gray-600"
            >
              📥 Download Empty Template
            </button>
            <a
              href="/sample_tools_upload.csv"
              download="sample_tools_upload.csv"
              class="flex-1 px-4 py-3 bg-blue-100 dark:bg-blue-900 text-blue-900 dark:text-blue-100 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-800 transition-colors font-medium text-center border-2 border-dashed border-blue-300 dark:border-blue-600"
            >
              📄 Download Sample with Data
            </a>
          </div>

          <!-- Upload Form -->
          <form id="bulk-upload-form" class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Upload CSV File *
              </label>
              <input
                type="file"
                id="csv-file-input"
                accept=".csv"
                required
                class="w-full px-4 py-2 rounded-lg border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"
              />
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Only CSV files are accepted</p>
            </div>

            <!-- Upload Progress -->
            <div id="upload-progress" class="hidden">
              <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                <div id="progress-bar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
              </div>
              <p id="progress-text" class="text-sm text-gray-600 dark:text-gray-400 mt-2 text-center"></p>
            </div>

            <!-- Results -->
            <div id="upload-results" class="hidden space-y-3"></div>

            <div class="flex items-center justify-end space-x-4 pt-4 border-t border-gray-200 dark:border-gray-700">
              <button type="button" id="cancel-bulk-btn" class="px-6 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600">
                Cancel
              </button>
              <button type="submit" id="upload-btn" class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700" data-testid="upload-csv-btn">
                Upload & Import
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

    <!-- Assign Tools Modal -->
    <div id="assign-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
      <div class="bg-white dark:bg-gray-800 rounded-lg p-6 max-w-2xl w-full max-h-[80vh] overflow-y-auto">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Assign Tools to Admin</h3>
        
        <div class="space-y-4">
          <!-- Select Admin -->
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Select Admin User *</label>
            <select id="assign-admin-select" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
              <option value="">-- Select an Admin --</option>
            </select>
          </div>
          
          <!-- Selected Tools -->
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Selected Tools (<span id="selected-tools-count">0</span>)
            </label>
            <div id="selected-tools-list" class="max-h-40 overflow-y-auto border border-gray-300 dark:border-gray-600 rounded-lg p-2">
              <p class="text-gray-500 dark:text-gray-400 text-sm">Select tools from the table below using checkboxes</p>
            </div>
          </div>
          
          <!-- Instructions -->
          <div class="bg-blue-50 dark:bg-blue-900/30 p-3 rounded-lg">
            <p class="text-sm text-blue-800 dark:text-blue-200">
              <strong>Tip:</strong> Check the boxes next to tools in the table, then click "Assign Selected" to assign them to the selected admin.
            </p>
          </div>
        </div>
        
        <div class="flex items-center justify-end space-x-4 pt-4 mt-4 border-t border-gray-200 dark:border-gray-700">
          <button type="button" id="close-assign-modal" class="px-6 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600">
            Cancel
          </button>
          <button type="button" id="assign-selected-btn" class="px-6 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700" data-testid="assign-selected-btn">
            Assign Selected
          </button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { superAdminApi, categoriesApi } from '~/utils/api';
  import { requireAdmin } from '~/utils/auth';

  // Check authentication
  requireAdmin();

  let currentSkip = 0;
  const limit = 20;
  let allCategories: any[] = [];
  let allAdmins: any[] = [];
  let editingToolId: string | null = null;
  let selectedToolIds: Set<string> = new Set();

  // Initialize
  async function init() {
    await loadCategories();
    await loadAdmins();
    await loadTools();
    setupEventListeners();
  }

  async function loadAdmins() {
    try {
      const response = await superAdminApi.users.getAll({ role: 'admin', limit: 100 });
      allAdmins = response.users || [];
      
      // Also include superadmins
      const superadminResponse = await superAdminApi.users.getAll({ role: 'superadmin', limit: 100 });
      if (superadminResponse.users) {
        allAdmins = [...allAdmins, ...superadminResponse.users];
      }
      
      // Populate admin select
      const adminSelect = document.getElementById('assign-admin-select') as HTMLSelectElement;
      adminSelect.innerHTML = '<option value="">-- Select an Admin --</option>';
      allAdmins.forEach(admin => {
        const option = document.createElement('option');
        option.value = admin.id;
        option.textContent = `${admin.username} (${admin.email}) - ${admin.role}`;
        adminSelect.appendChild(option);
      });
    } catch (error) {
      console.error('Error loading admins:', error);
    }
  }

  async function loadCategories() {
    try {
      allCategories = await categoriesApi.getAll();
      
      // Populate category filter
      const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
      allCategories.forEach(cat => {
        const option = document.createElement('option');
        option.value = cat.slug;
        option.textContent = cat.name;
        categoryFilter.appendChild(option);
      });

      // Populate modal categories
      const toolCategories = document.getElementById('tool-categories') as HTMLSelectElement;
      allCategories.forEach(cat => {
        const option = document.createElement('option');
        option.value = cat.id;
        option.textContent = cat.name;
        toolCategories.appendChild(option);
      });
    } catch (error) {
      console.error('Error loading categories:', error);
    }
  }

  async function loadTools() {
    const loading = document.getElementById('loading')!;
    const tableContainer = document.getElementById('tools-table-container')!;
    const tbody = document.getElementById('tools-tbody')!;
    
    loading.classList.remove('hidden');
    tableContainer.classList.add('hidden');

    try {
      const searchInput = (document.getElementById('search-input') as HTMLInputElement).value;
      const categoryFilter = (document.getElementById('category-filter') as HTMLSelectElement).value;
      const statusFilter = (document.getElementById('status-filter') as HTMLSelectElement).value;

      const params: any = {
        skip: currentSkip,
        limit: limit,
      };

      if (searchInput) params.search = searchInput;
      if (categoryFilter) params.category = categoryFilter;
      if (statusFilter) params.status = statusFilter;

      const tools = await superAdminApi.tools.getAll(params);

      tbody.innerHTML = tools.map((tool: any) => `
        <tr data-testid="tool-row-${tool.id}">
          <td class="px-4 py-4">
            <input type="checkbox" class="tool-checkbox w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" data-tool-id="${tool.id}" data-tool-name="${tool.name}" ${selectedToolIds.has(tool.id) ? 'checked' : ''} />
          </td>
          <td class="px-6 py-4">
            <div class="flex items-center space-x-3">
              ${tool.logo_url ? `<img src="${tool.logo_url}" alt="${tool.name}" class="h-10 w-10 object-contain rounded" />` : ''}
              <div>
                <div class="font-medium text-gray-900 dark:text-white">${tool.name}</div>
                <div class="text-sm text-gray-500 dark:text-gray-400">${tool.slug}</div>
                ${tool.claimed_by ? `<div class="text-xs text-purple-600 dark:text-purple-400">Assigned to: ${tool.claimed_by}</div>` : ''}
              </div>
            </div>
          </td>
          <td class="px-6 py-4">
            <div class="flex flex-wrap gap-1">
              ${tool.categories?.slice(0, 2).map((cat: any) => `
                <span class="px-2 py-1 text-xs bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded">${cat.name}</span>
              `).join('') || '<span class="text-gray-500">-</span>'}
            </div>
          </td>
          <td class="px-6 py-4">
            <span class="px-3 py-1 rounded-full text-xs font-medium ${
              tool.pricing_type === 'free' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' :
              tool.pricing_type === 'freemium' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200' :
              'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200'
            }">
              ${tool.pricing_type}
            </span>
          </td>
          <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300">
            <div>${tool.view_count} views</div>
            <div>${tool.review_count} reviews</div>
          </td>
          <td class="px-6 py-4">
            <span class="px-3 py-1 rounded-full text-xs font-medium ${
              tool.is_active ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'
            }">
              ${tool.is_active ? 'Active' : 'Inactive'}
            </span>
          </td>
          <td class="px-6 py-4 text-right space-x-2">
            <button onclick="window.editTool('${tool.id}')" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300" data-testid="edit-tool-${tool.id}">
              Edit
            </button>
            <button onclick="window.deleteTool('${tool.id}', '${tool.name}')" class="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300" data-testid="delete-tool-${tool.id}">
              Delete
            </button>
          </td>
        </tr>
      `).join('');

      // Add checkbox event listeners
      document.querySelectorAll('.tool-checkbox').forEach(checkbox => {
        checkbox.addEventListener('change', (e) => {
          const target = e.target as HTMLInputElement;
          const toolId = target.dataset.toolId!;
          const toolName = target.dataset.toolName!;
          
          if (target.checked) {
            selectedToolIds.add(toolId);
          } else {
            selectedToolIds.delete(toolId);
          }
          updateSelectedToolsList();
        });
      });

      loading.classList.add('hidden');
      tableContainer.classList.remove('hidden');
      document.getElementById('pagination')!.classList.remove('hidden');
      
      updatePaginationInfo(tools.length);
    } catch (error) {
      console.error('Error loading tools:', error);
      loading.classList.add('hidden');
    }
  }

  function updatePaginationInfo(count: number) {
    const pageInfo = document.getElementById('page-info')!;
    const start = currentSkip + 1;
    const end = currentSkip + count;
    pageInfo.textContent = `${start}-${end}`;

    const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
    
    prevBtn.disabled = currentSkip === 0;
    nextBtn.disabled = count < limit;
  }

  function setupEventListeners() {
    // Search with debounce
    let searchTimeout: any;
    document.getElementById('search-input')!.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        currentSkip = 0;
        loadTools();
      }, 500);
    });

    // Filter changes
    document.getElementById('category-filter')!.addEventListener('change', () => {
      currentSkip = 0;
      loadTools();
    });
    document.getElementById('status-filter')!.addEventListener('change', () => {
      currentSkip = 0;
      loadTools();
    });

    // Reset filters
    document.getElementById('reset-filters-btn')!.addEventListener('click', () => {
      (document.getElementById('search-input') as HTMLInputElement).value = '';
      (document.getElementById('category-filter') as HTMLSelectElement).value = '';
      (document.getElementById('status-filter') as HTMLSelectElement).value = '';
      currentSkip = 0;
      loadTools();
    });

    // Pagination
    document.getElementById('prev-btn')!.addEventListener('click', () => {
      if (currentSkip > 0) {
        currentSkip -= limit;
        loadTools();
      }
    });
    document.getElementById('next-btn')!.addEventListener('click', () => {
      currentSkip += limit;
      loadTools();
    });

    // Create tool button
    document.getElementById('create-tool-btn')!.addEventListener('click', () => {
      openToolModal();
    });

    // Modal close buttons
    document.getElementById('close-modal')!.addEventListener('click', closeToolModal);
    document.getElementById('cancel-btn')!.addEventListener('click', closeToolModal);

    // Tool form submit
    document.getElementById('tool-form')!.addEventListener('submit', handleToolSubmit);
    
    // Bulk upload modal handlers
    document.getElementById('bulk-upload-btn')!.addEventListener('click', openBulkUploadModal);
    document.getElementById('close-bulk-modal')!.addEventListener('click', closeBulkUploadModal);
    document.getElementById('cancel-bulk-btn')!.addEventListener('click', closeBulkUploadModal);
    document.getElementById('bulk-upload-form')!.addEventListener('submit', handleBulkUpload);
    document.getElementById('download-template-btn')!.addEventListener('click', downloadCSVTemplate);
  }

  // Bulk Upload Modal Functions
  function openBulkUploadModal() {
    const modal = document.getElementById('bulk-upload-modal')!;
    // Reset form and results
    (document.getElementById('bulk-upload-form') as HTMLFormElement).reset();
    document.getElementById('upload-results')!.classList.add('hidden');
    document.getElementById('upload-progress')!.classList.add('hidden');
    modal.classList.remove('hidden');
  }

  function closeBulkUploadModal() {
    const modal = document.getElementById('bulk-upload-modal')!;
    modal.classList.add('hidden');
  }

  async function downloadCSVTemplate() {
    // Create sample CSV content
    const headers = [
      'name', 'description', 'short_description', 'url', 'logo_url', 
      'pricing_type', 'features', 'pros', 'cons', 'is_active',
      'platform', 'best_for', 'free_trial', 'rating',
      'seo_title', 'seo_description', 'seo_keywords',
      'new_category', 'new_subcategory'
    ];
    
    const sampleData = [
      'AI Writing Assistant',
      'A powerful AI writing assistant that helps you create content faster and better. Uses advanced language models to generate, edit, and improve your writing.',
      'AI-powered writing tool for content creation',
      'https://example-ai-writer.com',
      'https://example.com/logo.png',
      'freemium',
      'AI content generation;Grammar correction;Tone adjustment;Multiple languages;Templates',
      'Easy to use;Great AI quality;Fast generation',
      'Limited free tier;Requires internet',
      'true',
      'Web;Chrome Extension;API',
      'Content writers;Marketers;Bloggers',
      'Yes - 7 days',
      '4.5',
      'AI Writing Assistant - Best AI Content Generator 2026',
      'Create amazing content with our AI Writing Assistant. Features include content generation, grammar checking, and more.',
      'AI writing, content generator, AI assistant, writing tool',
      'Create Content Faster',
      'AI Writing Software'
    ];
    
    const csvContent = [
      headers.join(','),
      sampleData.map(val => `"${val.replace(/"/g, '""')}"`).join(',')
    ].join('\n');
    
    // Create and download file
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'tools_upload_template.csv';
    link.click();
    URL.revokeObjectURL(link.href);
  }

  async function handleBulkUpload(e: Event) {
    e.preventDefault();
    
    const fileInput = document.getElementById('csv-file-input') as HTMLInputElement;
    const file = fileInput.files?.[0];
    
    if (!file) {
      alert('Please select a CSV file');
      return;
    }
    
    if (!file.name.endsWith('.csv')) {
      alert('Please upload a CSV file');
      return;
    }
    
    const uploadBtn = document.getElementById('upload-btn') as HTMLButtonElement;
    const progressDiv = document.getElementById('upload-progress')!;
    const progressBar = document.getElementById('progress-bar')!;
    const progressText = document.getElementById('progress-text')!;
    const resultsDiv = document.getElementById('upload-results')!;
    
    // Show progress
    uploadBtn.disabled = true;
    uploadBtn.textContent = 'Uploading...';
    progressDiv.classList.remove('hidden');
    progressBar.style.width = '30%';
    progressText.textContent = 'Uploading file...';
    
    try {
      const formData = new FormData();
      formData.append('file', file);
      
      progressBar.style.width = '50%';
      progressText.textContent = 'Processing CSV...';
      
      const API_URL = import.meta.env.PUBLIC_API_URL || '';
      const response = await fetch(`${API_URL}/api/superadmin/tools/bulk-upload`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${localStorage.getItem('auth_token')}`
        },
        body: formData
      });
      
      progressBar.style.width = '100%';
      
      const data = await response.json();
      
      if (response.ok) {
        progressText.textContent = 'Upload complete!';
        
        // Show results
        resultsDiv.classList.remove('hidden');
        resultsDiv.innerHTML = `
          <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-4">
            <h4 class="font-semibold text-green-900 dark:text-green-100 mb-2">✅ Success!</h4>
            <p class="text-green-800 dark:text-green-200">${data.message}</p>
            ${data.created_tools?.length ? `<p class="text-sm mt-2">Created: ${data.created_tools.slice(0, 10).join(', ')}${data.created_tools.length > 10 ? '...' : ''}</p>` : ''}
          </div>
          ${data.errors?.length ? `
            <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4">
              <h4 class="font-semibold text-yellow-900 dark:text-yellow-100 mb-2">⚠️ Warnings</h4>
              <ul class="text-sm text-yellow-800 dark:text-yellow-200 list-disc list-inside">
                ${data.errors.slice(0, 5).map((err: string) => `<li>${err}</li>`).join('')}
                ${data.errors.length > 5 ? `<li>... and ${data.errors.length - 5} more</li>` : ''}
              </ul>
            </div>
          ` : ''}
        `;
        
        // Reload tools list
        setTimeout(() => {
          loadTools();
        }, 1000);
        
      } else {
        progressText.textContent = 'Upload failed';
        resultsDiv.classList.remove('hidden');
        resultsDiv.innerHTML = `
          <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
            <h4 class="font-semibold text-red-900 dark:text-red-100 mb-2">❌ Error</h4>
            <p class="text-red-800 dark:text-red-200">${data.detail || 'Unknown error occurred'}</p>
          </div>
        `;
      }
      
    } catch (error: any) {
      progressBar.style.width = '0%';
      progressText.textContent = 'Upload failed';
      resultsDiv.classList.remove('hidden');
      resultsDiv.innerHTML = `
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
          <h4 class="font-semibold text-red-900 dark:text-red-100 mb-2">❌ Error</h4>
          <p class="text-red-800 dark:text-red-200">${error.message || 'Network error occurred'}</p>
        </div>
      `;
    } finally {
      uploadBtn.disabled = false;
      uploadBtn.textContent = 'Upload & Import';
    }
  }

  function openToolModal(tool?: any) {
    const modal = document.getElementById('tool-modal')!;
    const modalTitle = document.getElementById('modal-title')!;
    const form = document.getElementById('tool-form') as HTMLFormElement;
    
    form.reset();
    editingToolId = tool?.id || null;
    modalTitle.textContent = tool ? 'Edit Tool' : 'Add New Tool';

    if (tool) {
      (document.getElementById('tool-id') as HTMLInputElement).value = tool.id;
      (document.getElementById('tool-name') as HTMLInputElement).value = tool.name;
      (document.getElementById('tool-url') as HTMLInputElement).value = tool.url || '';
      (document.getElementById('tool-pricing') as HTMLSelectElement).value = tool.pricing_type;
      (document.getElementById('tool-short-desc') as HTMLInputElement).value = tool.short_description || '';
      (document.getElementById('tool-description') as HTMLTextAreaElement).value = tool.description;
      (document.getElementById('tool-logo') as HTMLInputElement).value = tool.logo_url || '';
      (document.getElementById('tool-screenshot') as HTMLInputElement).value = tool.screenshot_url || '';
      (document.getElementById('tool-active') as HTMLInputElement).checked = tool.is_active;
      (document.getElementById('tool-featured') as HTMLInputElement).checked = tool.is_featured;
      // New SEO/LLM fields
      (document.getElementById('tool-platform') as HTMLInputElement).value = tool.platform || '';
      (document.getElementById('tool-free-trial') as HTMLSelectElement).value = tool.free_trial || '';
      (document.getElementById('tool-rating') as HTMLInputElement).value = tool.rating?.toString() || '';
      (document.getElementById('tool-best-for') as HTMLInputElement).value = tool.best_for || '';
      (document.getElementById('tool-seo-title') as HTMLInputElement).value = tool.seo_title || '';
      (document.getElementById('tool-seo-description') as HTMLTextAreaElement).value = tool.seo_description || '';
      (document.getElementById('tool-seo-keywords') as HTMLInputElement).value = tool.seo_keywords || '';
      (document.getElementById('tool-faqs') as HTMLTextAreaElement).value = tool.faqs ? JSON.stringify(tool.faqs, null, 2) : '';
      (document.getElementById('tool-alternatives') as HTMLTextAreaElement).value = tool.alternatives ? JSON.stringify(tool.alternatives, null, 2) : '';
      (document.getElementById('tool-json-ld') as HTMLTextAreaElement).value = tool.json_ld ? JSON.stringify(tool.json_ld, null, 2) : '';

      // Select categories
      const categoriesSelect = document.getElementById('tool-categories') as HTMLSelectElement;
      Array.from(categoriesSelect.options).forEach(option => {
        option.selected = tool.categories?.some((cat: any) => cat.id === option.value);
      });
    }

    modal.classList.remove('hidden');
  }

  function closeToolModal() {
    document.getElementById('tool-modal')!.classList.add('hidden');
    editingToolId = null;
  }

  async function handleToolSubmit(e: Event) {
    e.preventDefault();
    
    const submitBtn = (e.target as HTMLFormElement).querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Saving...';

    try {
      const categoriesSelect = document.getElementById('tool-categories') as HTMLSelectElement;
      const selectedCategories = Array.from(categoriesSelect.selectedOptions).map(opt => opt.value);

      const toolData = {
        name: (document.getElementById('tool-name') as HTMLInputElement).value,
        url: (document.getElementById('tool-url') as HTMLInputElement).value,
        pricing_type: (document.getElementById('tool-pricing') as HTMLSelectElement).value,
        short_description: (document.getElementById('tool-short-desc') as HTMLInputElement).value,
        description: (document.getElementById('tool-description') as HTMLTextAreaElement).value,
        logo_url: (document.getElementById('tool-logo') as HTMLInputElement).value,
        screenshot_url: (document.getElementById('tool-screenshot') as HTMLInputElement).value,
        is_active: (document.getElementById('tool-active') as HTMLInputElement).checked,
        is_featured: (document.getElementById('tool-featured') as HTMLInputElement).checked,
        platform: (document.getElementById('tool-platform') as HTMLInputElement).value || null,
        free_trial: (document.getElementById('tool-free-trial') as HTMLSelectElement).value || null,
        rating: parseFloat((document.getElementById('tool-rating') as HTMLInputElement).value) || 0,
        best_for: (document.getElementById('tool-best-for') as HTMLInputElement).value || null,
        seo_title: (document.getElementById('tool-seo-title') as HTMLInputElement).value || null,
        seo_description: (document.getElementById('tool-seo-description') as HTMLTextAreaElement).value || null,
        seo_keywords: (document.getElementById('tool-seo-keywords') as HTMLInputElement).value || null,
        faqs: (() => { try { const v = (document.getElementById('tool-faqs') as HTMLTextAreaElement).value; return v ? JSON.parse(v) : null; } catch { alert('FAQs must be valid JSON'); return undefined; } })(),
        alternatives: (() => { try { const v = (document.getElementById('tool-alternatives') as HTMLTextAreaElement).value; return v ? JSON.parse(v) : null; } catch { alert('Alternatives must be valid JSON'); return undefined; } })(),
        json_ld: (() => { try { const v = (document.getElementById('tool-json-ld') as HTMLTextAreaElement).value; return v ? JSON.parse(v) : null; } catch { alert('JSON-LD must be valid JSON'); return undefined; } })(),
        category_ids: selectedCategories,
        features: [],
        pros: [],
        cons: []
      };

      // Abort if JSON parse failed
      if (toolData.faqs === undefined || toolData.alternatives === undefined || toolData.json_ld === undefined) {
        submitBtn.disabled = false; submitBtn.textContent = originalText; return;
      }

      if (editingToolId) {
        await superAdminApi.tools.update(editingToolId, toolData);
      } else {
        await superAdminApi.tools.create(toolData);
      }

      closeToolModal();
      loadTools();
      alert(editingToolId ? 'Tool updated successfully!' : 'Tool created successfully!');
    } catch (error: any) {
      console.error('Error saving tool:', error);
      alert('Failed to save tool: ' + (error.message || 'Unknown error'));
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  }

  // Global functions for inline event handlers
  (window as any).editTool = async function(toolId: string) {
    try {
      const tool = await superAdminApi.tools.getById(toolId);
      if (tool) {
        openToolModal(tool);
      }
    } catch (error) {
      console.error('Error loading tool:', error);
      alert('Failed to load tool details');
    }
  };

  (window as any).deleteTool = async function(toolId: string, toolName: string) {
    if (!confirm(`Are you sure you want to delete "${toolName}"? This action cannot be undone.`)) {
      return;
    }

    try {
      await superAdminApi.tools.delete(toolId);
      alert('Tool deleted successfully!');
      loadTools();
    } catch (error: any) {
      console.error('Error deleting tool:', error);
      alert('Failed to delete tool: ' + (error.message || 'Unknown error'));
    }
  };

  // Helper function to update selected tools list in modal
  function updateSelectedToolsList() {
    const listContainer = document.getElementById('selected-tools-list')!;
    const countSpan = document.getElementById('selected-tools-count')!;
    
    countSpan.textContent = String(selectedToolIds.size);
    
    if (selectedToolIds.size === 0) {
      listContainer.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-sm">Select tools from the table below using checkboxes</p>';
    } else {
      const checkboxes = document.querySelectorAll('.tool-checkbox:checked') as NodeListOf<HTMLInputElement>;
      const names: string[] = [];
      checkboxes.forEach(cb => names.push(cb.dataset.toolName || 'Unknown'));
      
      listContainer.innerHTML = names.map(name => 
        `<span class="inline-block px-2 py-1 m-1 text-xs bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded">${name}</span>`
      ).join('');
    }
  }

  // Open assign modal
  function openAssignModal() {
    const modal = document.getElementById('assign-modal')!;
    updateSelectedToolsList();
    modal.classList.remove('hidden');
  }

  // Close assign modal
  function closeAssignModal() {
    const modal = document.getElementById('assign-modal')!;
    modal.classList.add('hidden');
  }

  // Handle bulk assign
  async function handleBulkAssign() {
    const adminSelect = document.getElementById('assign-admin-select') as HTMLSelectElement;
    const adminId = adminSelect.value;
    
    if (!adminId) {
      alert('Please select an admin to assign tools to');
      return;
    }
    
    if (selectedToolIds.size === 0) {
      alert('Please select at least one tool to assign');
      return;
    }
    
    try {
      const response = await fetch(`${import.meta.env.PUBLIC_API_URL || ''}/api/superadmin/tools/bulk-assign`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${localStorage.getItem('auth_token')}`
        },
        body: JSON.stringify({
          tool_ids: Array.from(selectedToolIds),
          admin_id: adminId
        })
      });
      
      if (response.ok) {
        const data = await response.json();
        alert(data.message);
        closeAssignModal();
        selectedToolIds.clear();
        loadTools();
      } else {
        const error = await response.json();
        alert('Failed to assign tools: ' + (error.detail || 'Unknown error'));
      }
    } catch (error: any) {
      console.error('Error assigning tools:', error);
      alert('Failed to assign tools: ' + (error.message || 'Unknown error'));
    }
  }

  // Setup additional event listeners for assign functionality
  document.getElementById('assign-tools-btn')?.addEventListener('click', openAssignModal);
  document.getElementById('close-assign-modal')?.addEventListener('click', closeAssignModal);
  document.getElementById('assign-selected-btn')?.addEventListener('click', handleBulkAssign);
  
  // Select all checkbox
  document.getElementById('select-all-tools')?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    const checkboxes = document.querySelectorAll('.tool-checkbox') as NodeListOf<HTMLInputElement>;
    
    checkboxes.forEach(cb => {
      cb.checked = target.checked;
      const toolId = cb.dataset.toolId!;
      if (target.checked) {
        selectedToolIds.add(toolId);
      } else {
        selectedToolIds.delete(toolId);
      }
    });
    
    updateSelectedToolsList();
  });

  // Initialize on page load
  init();
</script>
