---
import AdminLayout from '~/layouts/AdminLayout.astro';

const metadata = {
  title: 'Site Settings - Admin',
};
---

<AdminLayout metadata={metadata}>
  <div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Site Settings</h1>
        <p class="text-gray-600 dark:text-gray-400 mt-2">Manage your site logo and branding</p>
      </div>
    </div>

    <!-- Success/Error Messages -->
    <div id="success-message" class="hidden mb-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
      <span id="success-text"></span>
    </div>
    <div id="error-message" class="hidden mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
      <span id="error-text"></span>
    </div>

    <!-- Current Logo Preview -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-8">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Current Logo</h2>
      <div class="flex items-center space-x-4 mb-4">
        <div id="logo-preview" class="p-4 bg-gray-100 dark:bg-gray-700 rounded-lg min-w-[200px]">
          <div class="flex items-center">
            <svg class="w-8 h-8 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <span id="site-name-display" class="text-xl font-bold">MarketMindAI</span>
          </div>
        </div>
        <div class="text-gray-500 dark:text-gray-400">
          <p class="text-sm">This logo appears in:</p>
          <ul class="text-sm mt-1 list-disc list-inside">
            <li>Navigation header</li>
            <li>Footer</li>
            <li>Browser tab (favicon)</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Update Logo Form -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Upload Logo -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Upload New Logo</h2>
        <form id="upload-logo-form" enctype="multipart/form-data">
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Logo Image
            </label>
            <div class="flex items-center justify-center w-full">
              <label for="logo-file" class="flex flex-col items-center justify-center w-full h-32 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50 dark:hover:bg-bray-800 dark:bg-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:hover:border-gray-500 dark:hover:bg-gray-600">
                <div class="flex flex-col items-center justify-center pt-5 pb-6">
                  <svg class="w-8 h-8 mb-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                  </svg>
                  <p class="mb-2 text-sm text-gray-500 dark:text-gray-400"><span class="font-semibold">Click to upload</span></p>
                  <p class="text-xs text-gray-500 dark:text-gray-400">PNG, JPG, SVG or WebP (MAX. 2MB)</p>
                </div>
                <input id="logo-file" name="file" type="file" class="hidden" accept="image/png,image/jpeg,image/svg+xml,image/webp,image/gif" />
              </label>
            </div>
            <div id="file-selected" class="mt-2 text-sm text-gray-600 dark:text-gray-400 hidden">
              Selected: <span id="selected-filename"></span>
            </div>
          </div>
          <button
            type="submit"
            class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition disabled:opacity-50"
            data-testid="upload-logo-btn"
          >
            Upload Logo
          </button>
        </form>
      </div>

      <!-- Logo URL -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Or Enter Logo URL</h2>
        <form id="url-logo-form">
          <div class="mb-4">
            <label for="logo-url" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Logo URL
            </label>
            <input
              type="url"
              id="logo-url"
              name="logo_url"
              placeholder="https://example.com/logo.png"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
              data-testid="logo-url-input"
            />
          </div>
          <button
            type="submit"
            class="w-full px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition disabled:opacity-50"
            data-testid="set-logo-url-btn"
          >
            Set Logo URL
          </button>
        </form>
      </div>
    </div>

    <!-- Site Name -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mt-8">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Site Name</h2>
      <form id="site-name-form">
        <div class="flex gap-4">
          <input
            type="text"
            id="site-name"
            name="site_name"
            placeholder="MarketMindAI"
            class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
            data-testid="site-name-input"
          />
          <button
            type="submit"
            class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition disabled:opacity-50"
            data-testid="update-site-name-btn"
          >
            Update Name
          </button>
        </div>
      </form>
    </div>

    <!-- Favicon Upload -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mt-8">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Favicon (Browser Tab Icon)</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
          <p class="text-gray-600 dark:text-gray-400 mb-4">Upload a favicon for browser tabs. Recommended: 32x32 or 64x64 PNG/ICO file.</p>
          <form id="upload-favicon-form" enctype="multipart/form-data">
            <div class="mb-4">
              <label for="favicon-file" class="flex flex-col items-center justify-center w-full h-24 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50 dark:hover:bg-bray-800 dark:bg-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:hover:border-gray-500">
                <div class="flex items-center justify-center pt-3 pb-3">
                  <svg class="w-6 h-6 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                  </svg>
                  <p class="text-sm text-gray-500"><span class="font-semibold">Upload Favicon</span> (PNG, ICO, max 512KB)</p>
                </div>
                <input id="favicon-file" name="file" type="file" class="hidden" accept="image/png,image/x-icon,image/ico,image/svg+xml,image/webp" />
              </label>
              <div id="favicon-selected" class="mt-2 text-sm text-gray-600 dark:text-gray-400 hidden">
                Selected: <span id="selected-favicon-name"></span>
              </div>
            </div>
            <button type="submit" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition">
              Upload Favicon
            </button>
          </form>
        </div>
        <div>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Current Favicon Preview:</p>
          <div id="favicon-preview" class="p-4 bg-gray-100 dark:bg-gray-700 rounded-lg inline-block">
            <img src="/favicon.ico" alt="Current favicon" class="w-8 h-8" id="current-favicon-img" />
          </div>
        </div>
      </div>
    </div>

    <!-- Reset Logo -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mt-8">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Reset to Default</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-4">Remove custom logo and restore the default text logo.</p>
      <button
        id="reset-logo-btn"
        class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition"
        data-testid="reset-logo-btn"
      >
        Reset Logo
      </button>
    </div>

    <!-- Analytics & Monetization -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mt-8">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Analytics & Monetization</h2>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">These are injected into every page server-side automatically</p>
        </div>
        <span class="px-3 py-1 bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300 text-xs rounded-full font-medium">SSR Injected</span>
      </div>

      <form id="analytics-form" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Google Analytics -->
          <div>
            <label for="analytics-id" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Google Analytics 4 (GA4) ID
            </label>
            <div class="flex gap-2">
              <input
                type="text"
                id="analytics-id"
                name="analytics_id"
                placeholder="G-XXXXXXXXXX"
                class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                data-testid="analytics-id-input"
              />
              <a href="https://analytics.google.com" target="_blank" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded-lg text-xs hover:bg-gray-200 flex items-center whitespace-nowrap">Get ID</a>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Format: G-XXXXXXXXXX (GA4) or UA-XXXXXX-X (Universal)</p>
          </div>

          <!-- Google AdSense -->
          <div>
            <label for="adsense-id" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Google AdSense Publisher ID
            </label>
            <div class="flex gap-2">
              <input
                type="text"
                id="adsense-id"
                name="adsense_id"
                placeholder="ca-pub-XXXXXXXXXXXXXXXX"
                class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                data-testid="adsense-id-input"
              />
              <a href="https://adsense.google.com" target="_blank" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded-lg text-xs hover:bg-gray-200 flex items-center whitespace-nowrap">Get ID</a>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Format: ca-pub-XXXXXXXXXXXXXXXX</p>
          </div>

          <!-- GTM -->
          <div>
            <label for="gtm-id" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Google Tag Manager ID (optional)
            </label>
            <input
              type="text"
              id="gtm-id"
              name="gtm_id"
              placeholder="GTM-XXXXXXX"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
              data-testid="gtm-id-input"
            />
          </div>

          <!-- Contact Email -->
          <div>
            <label for="contact-email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Contact Email
            </label>
            <input
              type="email"
              id="contact-email"
              name="contact_email"
              placeholder="contact@marketmindai.com"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
            />
          </div>
        </div>

        <!-- Custom Head Code -->
        <div>
          <label for="custom-head-code" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            Custom Head Code (HTML)
            <span class="text-xs text-gray-400 font-normal ml-1">Injected into &lt;head&gt; on every page</span>
          </label>
          <textarea
            id="custom-head-code"
            name="custom_head_code"
            rows="4"
            placeholder="<!-- Paste custom tracking scripts, meta tags, etc. -->"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white font-mono text-sm"
            data-testid="custom-head-code-input"
          ></textarea>
          <p class="text-xs text-gray-500 mt-1">Supports Meta Pixel, LinkedIn Insight Tag, Hotjar, Clarity, etc.</p>
        </div>

        <div class="flex items-center gap-4">
          <button
            type="submit"
            class="px-8 py-2.5 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition"
            data-testid="save-analytics-btn"
          >
            Save Analytics Settings
          </button>
          <span id="analytics-status" class="text-sm text-green-600 dark:text-green-400 hidden font-medium">Saved!</span>
        </div>
      </form>

      <!-- Integration Status -->
      <div id="analytics-status-cards" class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div id="ga-status-card" class="p-3 rounded-lg border border-gray-200 dark:border-gray-700 flex items-center gap-3">
          <div id="ga-dot" class="w-2.5 h-2.5 rounded-full bg-gray-300"></div>
          <div>
            <p class="text-xs font-medium text-gray-700 dark:text-gray-300">Google Analytics</p>
            <p id="ga-status-text" class="text-xs text-gray-500">Not configured</p>
          </div>
        </div>
        <div id="adsense-status-card" class="p-3 rounded-lg border border-gray-200 dark:border-gray-700 flex items-center gap-3">
          <div id="adsense-dot" class="w-2.5 h-2.5 rounded-full bg-gray-300"></div>
          <div>
            <p class="text-xs font-medium text-gray-700 dark:text-gray-300">Google AdSense</p>
            <p id="adsense-status-text" class="text-xs text-gray-500">Not configured</p>
          </div>
        </div>
        <div id="gtm-status-card" class="p-3 rounded-lg border border-gray-200 dark:border-gray-700 flex items-center gap-3">
          <div id="gtm-dot" class="w-2.5 h-2.5 rounded-full bg-gray-300"></div>
          <div>
            <p class="text-xs font-medium text-gray-700 dark:text-gray-300">Tag Manager</p>
            <p id="gtm-status-text" class="text-xs text-gray-500">Not configured</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
const API_URL = (import.meta as any).env?.PUBLIC_API_URL || window.location.origin;

    function getAuthToken() {
      return localStorage.getItem('token') || localStorage.getItem('auth_token');
    }

    function showSuccess(message) {
      const successDiv = document.getElementById('success-message');
      const successText = document.getElementById('success-text');
      successText.textContent = message;
      successDiv.classList.remove('hidden');
      document.getElementById('error-message').classList.add('hidden');
      setTimeout(() => successDiv.classList.add('hidden'), 5000);
    }

    function showError(message) {
      const errorDiv = document.getElementById('error-message');
      const errorText = document.getElementById('error-text');
      errorText.textContent = message;
      errorDiv.classList.remove('hidden');
      document.getElementById('success-message').classList.add('hidden');
      setTimeout(() => errorDiv.classList.add('hidden'), 5000);
    }

    function updateLogoPreview(logoUrl, siteName) {
      const preview = document.getElementById('logo-preview');
      const nameDisplay = document.getElementById('site-name-display');
      
      if (logoUrl) {
        preview.innerHTML = `
          <div class="flex items-center">
            <img src="${logoUrl}" alt="${siteName}" class="h-10 w-auto mr-2" />
            <span class="text-xl font-bold">${siteName}</span>
          </div>
        `;
      } else {
        preview.innerHTML = `
          <div class="flex items-center">
            <svg class="w-8 h-8 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <span class="text-xl font-bold">${siteName}</span>
          </div>
        `;
      }
      
      document.getElementById('site-name').value = siteName;
    }

    // Load current settings
    async function loadCurrentSettings() {
      try {
        const response = await fetch(`${API_URL}/api/site-settings/logo`);
        if (response.ok) {
          const data = await response.json();
          updateLogoPreview(data.logo_url, data.site_name);
          if (data.logo_url) {
            document.getElementById('logo-url').value = data.logo_url;
          }
        }
      } catch (error) {
        console.error('Failed to load settings:', error);
      }
    }

    // File upload handler
    document.getElementById('logo-file').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        document.getElementById('file-selected').classList.remove('hidden');
        document.getElementById('selected-filename').textContent = file.name;
      }
    });

    // Upload logo form
    document.getElementById('upload-logo-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const fileInput = document.getElementById('logo-file');
      
      if (!fileInput.files[0]) {
        showError('Please select a file to upload');
        return;
      }

      const formData = new FormData();
      formData.append('file', fileInput.files[0]);

      try {
        const response = await fetch(`${API_URL}/api/superadmin/site-settings/logo/upload`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`
          },
          body: formData
        });

        if (response.ok) {
          const data = await response.json();
          showSuccess('Logo uploaded successfully!');
          updateLogoPreview(data.logo_url, data.site_name);
          document.getElementById('logo-url').value = data.logo_url;
        } else {
          const error = await response.json();
          showError(error.detail || 'Failed to upload logo');
        }
      } catch (error) {
        showError('Network error. Please try again.');
      }
    });

    // URL logo form
    document.getElementById('url-logo-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const logoUrl = document.getElementById('logo-url').value;
      
      if (!logoUrl) {
        showError('Please enter a logo URL');
        return;
      }

      try {
        const response = await fetch(`${API_URL}/api/superadmin/site-settings/logo`, {
          method: 'PUT',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ logo_url: logoUrl })
        });

        if (response.ok) {
          const data = await response.json();
          showSuccess('Logo URL updated successfully!');
          updateLogoPreview(data.logo_url, data.site_name);
        } else {
          const error = await response.json();
          showError(error.detail || 'Failed to update logo URL');
        }
      } catch (error) {
        showError('Network error. Please try again.');
      }
    });

    // Site name form
    document.getElementById('site-name-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const siteName = document.getElementById('site-name').value;
      
      if (!siteName) {
        showError('Please enter a site name');
        return;
      }

      try {
        const response = await fetch(`${API_URL}/api/superadmin/settings/site_name`, {
          method: 'PUT',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ value: siteName, description: 'Site name' })
        });

        if (response.ok) {
          showSuccess('Site name updated successfully!');
          loadCurrentSettings();
        } else {
          const error = await response.json();
          showError(error.detail || 'Failed to update site name');
        }
      } catch (error) {
        showError('Network error. Please try again.');
      }
    });

    // Favicon file selection handler
    document.getElementById('favicon-file').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        document.getElementById('favicon-selected').classList.remove('hidden');
        document.getElementById('selected-favicon-name').textContent = file.name;
      }
    });

    // Favicon upload form
    document.getElementById('upload-favicon-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const fileInput = document.getElementById('favicon-file');
      
      if (!fileInput.files[0]) {
        showError('Please select a favicon file');
        return;
      }

      const formData = new FormData();
      formData.append('file', fileInput.files[0]);

      try {
        const response = await fetch(`${API_URL}/api/superadmin/site-settings/favicon/upload`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`
          },
          body: formData
        });

        if (response.ok) {
          const data = await response.json();
          showSuccess('Favicon uploaded successfully! Refresh the page to see the new favicon.');
          // Update preview
          const faviconImg = document.getElementById('current-favicon-img');
          faviconImg.src = `${API_URL}${data.favicon_url}?t=${Date.now()}`;
        } else {
          const error = await response.json();
          showError(error.detail || 'Failed to upload favicon');
        }
      } catch (error) {
        showError('Network error. Please try again.');
      }
    });

    // Reset logo button
    document.getElementById('reset-logo-btn').addEventListener('click', async () => {
      if (!confirm('Are you sure you want to reset the logo to default?')) return;
      
      const token = getAuthToken();

      try {
        const response = await fetch(`${API_URL}/api/superadmin/settings/site_logo_url`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${token}`
          }
        });

        if (response.ok) {
          showSuccess('Logo reset to default!');
          updateLogoPreview(null, 'MarketMindAI');
          document.getElementById('logo-url').value = '';
        } else {
          const error = await response.json();
          showError(error.detail || 'Failed to reset logo');
        }
      } catch (error) {
        showError('Network error. Please try again.');
      }
    });

    // Load settings on page load
    loadCurrentSettings();
    loadAnalyticsSettings();

    // ─── Analytics Settings ─────────────────────────────────────────────────
    async function loadAnalyticsSettings() {
      try {
        const res = await fetch(`${API_URL}/api/site-settings/analytics`);
        if (!res.ok) return;
        const data = await res.json();
        
        if (data.analytics_id) (document.getElementById('analytics-id') as HTMLInputElement).value = data.analytics_id;
        if (data.adsense_id) (document.getElementById('adsense-id') as HTMLInputElement).value = data.adsense_id;
        if (data.gtm_id) (document.getElementById('gtm-id') as HTMLInputElement).value = data.gtm_id;
        if (data.custom_head_code) (document.getElementById('custom-head-code') as HTMLTextAreaElement).value = data.custom_head_code;
        
        updateStatusCards(data);
      } catch {}
    }

    function updateStatusCards(data: any) {
      const setStatus = (dotId: string, textId: string, value: string, label: string) => {
        const dot = document.getElementById(dotId);
        const text = document.getElementById(textId);
        if (value) {
          dot!.classList.replace('bg-gray-300', 'bg-green-500');
          text!.textContent = value.substring(0, 20) + (value.length > 20 ? '...' : '');
        } else {
          dot!.classList.replace('bg-green-500', 'bg-gray-300');
          text!.textContent = 'Not configured';
        }
      };
      setStatus('ga-dot', 'ga-status-text', data.analytics_id || '', 'GA4 ID');
      setStatus('adsense-dot', 'adsense-status-text', data.adsense_id || '', 'AdSense ID');
      setStatus('gtm-dot', 'gtm-status-text', data.gtm_id || '', 'GTM ID');
    }

    document.getElementById('analytics-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const analyticsId = (document.getElementById('analytics-id') as HTMLInputElement).value.trim();
      const adsenseId = (document.getElementById('adsense-id') as HTMLInputElement).value.trim();
      const gtmId = (document.getElementById('gtm-id') as HTMLInputElement).value.trim();
      const contactEmail = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim() || '';
      const customHeadCode = (document.getElementById('custom-head-code') as HTMLTextAreaElement).value;

      try {
        const res = await fetch(`${API_URL}/api/superadmin/site-settings/analytics`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({
            analytics_id: analyticsId,
            adsense_id: adsenseId,
            gtm_id: gtmId,
            contact_email: contactEmail,
            custom_head_code: customHeadCode,
          })
        });
        if (res.ok) {
          showSuccess('Analytics settings saved! Changes will apply on next page load.');
          const statusEl = document.getElementById('analytics-status');
          statusEl!.classList.remove('hidden');
          setTimeout(() => statusEl!.classList.add('hidden'), 4000);
          updateStatusCards({ analytics_id: analyticsId, adsense_id: adsenseId, gtm_id: gtmId });
        } else {
          const error = await res.json();
          showError(error.detail || 'Failed to save analytics settings');
        }
      } catch {
        showError('Network error. Please try again.');
      }
    });
  </script>
</AdminLayout>
