---
import Layout from '~/layouts/PageLayout.astro';

export async function getStaticPaths() {
  // This will be generated at build time
  // For now, return empty for SSR
  return [];
}

const { slug } = Astro.params;

const metadata = {
  title: 'Tool Details',
  description: 'Detailed information about the tool',
};
---

<Layout metadata={metadata}>
  <div id="tool-detail-container" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Loading State -->
    <div id="loading" class="text-center py-12">
      <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      <p class="mt-4 text-gray-600 dark:text-gray-400">Loading tool details...</p>
    </div>

    <!-- Tool Detail Content (rendered by JS) -->
    <div id="tool-content" class="hidden">
      <!-- Content will be rendered here -->
    </div>

    <!-- Error State -->
    <div id="error" class="hidden text-center py-12">
      <p class="text-xl text-red-600 dark:text-red-400">Tool not found or error loading data.</p>
      <a href="/tools" class="mt-4 inline-block text-blue-600 hover:text-blue-800">
        &larr; Back to Tools
      </a>
    </div>
  </div>
</Layout>

<script define:vars={{ slug }}>
  import { toolsApi } from '~/utils/api';

  async function loadToolDetail() {
    const loading = document.getElementById('loading');
    const content = document.getElementById('tool-content');
    const error = document.getElementById('error');

    try {
      const tool = await toolsApi.getBySlug(slug);
      
      loading.classList.add('hidden');
      content.classList.remove('hidden');
      
      // Render tool detail
      content.innerHTML = `
        <!-- Back Button -->
        <div class="mb-6">
          <a href="/tools" class="inline-flex items-center text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back to Tools
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Main Content (2/3) -->
          <div class="lg:col-span-2 space-y-8">
            <!-- Tool Header -->
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8">
              <div class="flex items-start space-x-6">
                ${tool.logo_url ? `
                  <img src="${tool.logo_url}" alt="${tool.name} logo" class="h-24 w-24 object-contain rounded-lg" />
                ` : ''}
                <div class="flex-1">
                  <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-2" data-testid="tool-title">
                    ${tool.name}
                  </h1>
                  <p class="text-xl text-gray-600 dark:text-gray-300 mb-4">
                    ${tool.short_description || ''}
                  </p>
                  <div class="flex items-center space-x-4 text-sm">
                    <div class="flex items-center">
                      <span class="text-yellow-500 text-xl mr-1">★</span>
                      <span class="text-gray-900 dark:text-white font-medium text-lg">${tool.rating.toFixed(1)}</span>
                      <span class="text-gray-500 dark:text-gray-400 ml-1">(${tool.review_count} reviews)</span>
                    </div>
                    <span class="px-3 py-1 rounded-full text-sm font-medium ${
                      tool.pricing_type === 'free' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' :
                      tool.pricing_type === 'freemium' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200' :
                      'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200'
                    }">
                      ${tool.pricing_type.charAt(0).toUpperCase() + tool.pricing_type.slice(1)}
                    </span>
                  </div>
                </div>
              </div>
              
              ${tool.url ? `
                <div class="mt-6">
                  <a 
                    href="${tool.url}" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
                    data-testid="visit-website-btn"
                  >
                    Visit Website
                    <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              ` : ''}
            </div>

            <!-- Description -->
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">About ${tool.name}</h2>
              <div class="prose dark:prose-invert max-w-none">
                <p class="text-gray-700 dark:text-gray-300">${tool.description}</p>
              </div>
            </div>

            <!-- Features -->
            ${tool.features && tool.features.length > 0 ? `
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Key Features</h2>
                <ul class="space-y-3">
                  ${tool.features.map(feature => `
                    <li class="flex items-start">
                      <svg class="w-6 h-6 text-green-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      <span class="text-gray-700 dark:text-gray-300">${feature}</span>
                    </li>
                  `).join('')}
                </ul>
              </div>
            ` : ''}

            <!-- Pros and Cons -->
            ${(tool.pros && tool.pros.length > 0) || (tool.cons && tool.cons.length > 0) ? `
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                ${tool.pros && tool.pros.length > 0 ? `
                  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                    <h3 class="text-xl font-bold text-green-600 dark:text-green-400 mb-4">Pros</h3>
                    <ul class="space-y-2">
                      ${tool.pros.map(pro => `
                        <li class="flex items-start">
                          <span class="text-green-500 mr-2">✓</span>
                          <span class="text-gray-700 dark:text-gray-300">${pro}</span>
                        </li>
                      `).join('')}
                    </ul>
                  </div>
                ` : ''}
                ${tool.cons && tool.cons.length > 0 ? `
                  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                    <h3 class="text-xl font-bold text-red-600 dark:text-red-400 mb-4">Cons</h3>
                    <ul class="space-y-2">
                      ${tool.cons.map(con => `
                        <li class="flex items-start">
                          <span class="text-red-500 mr-2">✗</span>
                          <span class="text-gray-700 dark:text-gray-300">${con}</span>
                        </li>
                      `).join('')}
                    </ul>
                  </div>
                ` : ''}
              </div>
            ` : ''}
          </div>

          <!-- Sidebar (1/3) -->
          <div class="space-y-6">
            <!-- Quick Stats -->
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Quick Stats</h3>
              <div class="space-y-3">
                <div class="flex justify-between">
                  <span class="text-gray-600 dark:text-gray-400">Views</span>
                  <span class="font-medium text-gray-900 dark:text-white">${tool.view_count.toLocaleString()}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600 dark:text-gray-400">Reviews</span>
                  <span class="font-medium text-gray-900 dark:text-white">${tool.review_count}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600 dark:text-gray-400">Likes</span>
                  <span class="font-medium text-gray-900 dark:text-white">${tool.like_count}</span>
                </div>
              </div>
            </div>

            <!-- Categories -->
            ${tool.categories && tool.categories.length > 0 ? `
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Categories</h3>
                <div class="flex flex-wrap gap-2">
                  ${tool.categories.map(cat => `
                    <a 
                      href="/tools?category=${cat.slug}" 
                      class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm hover:bg-blue-200 dark:hover:bg-blue-800 transition-colors"
                    >
                      ${cat.name}
                    </a>
                  `).join('')}
                </div>
              </div>
            ` : ''}

            <!-- Company Info -->
            ${tool.about || tool.company_location || tool.started_on ? `
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Company Info</h3>
                <div class="space-y-3 text-sm">
                  ${tool.company_location ? `
                    <div>
                      <span class="text-gray-600 dark:text-gray-400">Location:</span>
                      <span class="text-gray-900 dark:text-white ml-2">${tool.company_location}</span>
                    </div>
                  ` : ''}
                  ${tool.started_on ? `
                    <div>
                      <span class="text-gray-600 dark:text-gray-400">Founded:</span>
                      <span class="text-gray-900 dark:text-white ml-2">${tool.started_on}</span>
                    </div>
                  ` : ''}
                </div>
              </div>
            ` : ''}
          </div>
        </div>
      `;
    } catch (err) {
      console.error('Error loading tool:', err);
      loading.classList.add('hidden');
      error.classList.remove('hidden');
    }
  }

  loadToolDetail();
</script>
