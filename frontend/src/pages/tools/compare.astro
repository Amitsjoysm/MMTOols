---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Compare Tools - MarketMindAI',
  description: 'Compare AI tools and business solutions side-by-side to make informed decisions.',
};
---

<Layout metadata={metadata}>
  <!-- Auth Gate Overlay - shown until authentication is verified -->
  <div id="auth-gate-overlay" class="fixed inset-0 bg-gray-900/95 z-[9999] flex items-center justify-center">
    <div class="text-center text-white p-8 max-w-md">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-white mx-auto mb-4" id="auth-loading"></div>
      <div id="auth-gate-content" class="hidden">
        <svg class="w-16 h-16 mx-auto mb-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <h2 class="text-2xl font-bold mb-2">Login Required</h2>
        <p class="mb-6 text-gray-300">Please login to access the tool comparison feature.</p>
        <a href="/auth/login?redirect=/tools/compare" class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition" data-testid="login-to-compare-btn">
          Login to Compare Tools
        </a>
        <p class="mt-4 text-sm text-gray-400">
          Don't have an account? <a href="/auth/register" class="text-blue-400 hover:text-blue-300">Register here</a>
        </p>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Compare Tools
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Select tools to compare their features, pricing, and ratings side-by-side.
      </p>
    </div>

    <!-- Tool Selection -->
    <div id="tool-selector" class="mb-8">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Select Tools to Compare (max 5)</h2>
        
        <!-- Search for tools -->
        <div class="mb-4">
          <input
            type="text"
            id="tool-search"
            placeholder="Search for tools to add..."
            class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            data-testid="tool-search-input"
          />
        </div>
        
        <!-- Search results -->
        <div id="search-results" class="hidden mb-4 max-h-60 overflow-y-auto space-y-2" data-testid="search-results"></div>
        
        <!-- Selected tools -->
        <div id="selected-tools" class="flex flex-wrap gap-2 min-h-12" data-testid="selected-tools"></div>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loading" class="hidden text-center py-12">
      <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      <p class="mt-4 text-gray-600 dark:text-gray-400">Loading comparison...</p>
    </div>

    <!-- AI Comparison Results -->
    <div id="ai-comparison-section" class="hidden mt-8 bg-gradient-to-r from-purple-50 to-blue-50 dark:from-purple-900/20 dark:to-blue-900/20 rounded-xl p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
          <span class="text-2xl">🤖</span> AI Analysis
        </h3>
        <span class="px-3 py-1 bg-purple-100 dark:bg-purple-800 text-purple-800 dark:text-purple-200 text-sm rounded-full">
          Powered by AI
        </span>
      </div>
      <div id="ai-comparison-content" class="prose dark:prose-invert max-w-none">
        <!-- AI analysis will be inserted here -->
      </div>
    </div>

    <!-- Comparison Table -->
    <div id="comparison-container" class="hidden" data-testid="comparison-table">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white">Side-by-Side Comparison</h3>
        <button
          id="ai-compare-btn"
          class="px-4 py-2 bg-gradient-to-r from-purple-600 to-blue-600 text-white rounded-lg hover:from-purple-700 hover:to-blue-700 transition-all font-medium flex items-center gap-2 disabled:opacity-50"
        >
          <span>🤖</span> Get AI Analysis
        </button>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full bg-white dark:bg-gray-800 rounded-lg shadow-md">
          <thead>
            <tr id="comparison-header" class="border-b border-gray-200 dark:border-gray-700">
              <th class="p-4 text-left text-gray-900 dark:text-white font-bold sticky left-0 bg-white dark:bg-gray-800">Feature</th>
            </tr>
          </thead>
          <tbody id="comparison-body">
            <!-- Comparison rows will be added here -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="text-center py-12">
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-4">
        Search and select tools above to start comparing.
      </p>
      <a href="/tools" class="inline-block text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">
        Browse All Tools →
      </a>
    </div>
  </div>
</Layout>

<script>
  import { toolsApi } from '~/utils/api';

  let selectedTools: any[] = [];
  let searchTimeout: any;
  let allToolsCache: any[] = [];

  async function init() {
    // Load from URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    const toolIds = urlParams.get('tools');
    
    if (toolIds) {
      const ids = toolIds.split(',');
      await loadComparison(ids);
    }
    
    setupEventListeners();
    
    // Load all tools for search
    try {
      allToolsCache = await toolsApi.getAll({ limit: 100 });
    } catch (error) {
      console.error('Error loading tools:', error);
    }
  }

  function setupEventListeners() {
    const searchInput = document.getElementById('tool-search') as HTMLInputElement;
    
    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => searchTools(searchInput.value), 300);
    });
  }

  function searchTools(query: string) {
    const resultsDiv = document.getElementById('search-results')!;
    
    if (!query || query.length < 2) {
      resultsDiv.classList.add('hidden');
      return;
    }
    
    const filtered = allToolsCache
      .filter(tool => 
        !selectedTools.find(st => st.id === tool.id) &&
        (tool.name.toLowerCase().includes(query.toLowerCase()) ||
         tool.description.toLowerCase().includes(query.toLowerCase()))
      )
      .slice(0, 5);
    
    if (filtered.length === 0) {
      resultsDiv.classList.add('hidden');
      return;
    }
    
    resultsDiv.innerHTML = filtered.map(tool => `
      <button
        onclick="window.addToolToComparison('${tool.id}')"
        class="w-full text-left p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors flex items-center space-x-3"
        data-testid="add-tool-${tool.slug}"
      >
        ${tool.logo_url ? `<img src="${tool.logo_url}" alt="${tool.name}" class="w-10 h-10 object-contain rounded" />` : ''}
        <div class="flex-1">
          <div class="font-medium text-gray-900 dark:text-white">${tool.name}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">${tool.short_description || ''}</div>
        </div>
      </button>
    `).join('');
    
    resultsDiv.classList.remove('hidden');
  }

  (window as any).addToolToComparison = function(toolId: string) {
    if (selectedTools.length >= 5) {
      alert('Maximum 5 tools can be compared at once');
      return;
    }
    
    const tool = allToolsCache.find(t => t.id === toolId);
    if (!tool) return;
    
    selectedTools.push(tool);
    updateSelectedTools();
    updateComparison();
    
    // Clear search
    const searchInput = document.getElementById('tool-search') as HTMLInputElement;
    searchInput.value = '';
    document.getElementById('search-results')!.classList.add('hidden');
    
    // Update URL
    updateURL();
  };

  (window as any).removeToolFromComparison = function(toolId: string) {
    selectedTools = selectedTools.filter(t => t.id !== toolId);
    updateSelectedTools();
    updateComparison();
    updateURL();
  };

  function updateSelectedTools() {
    const container = document.getElementById('selected-tools')!;
    
    if (selectedTools.length === 0) {
      container.innerHTML = '<p class="text-gray-500 dark:text-gray-400 py-2">No tools selected</p>';
      return;
    }
    
    container.innerHTML = selectedTools.map(tool => `
      <div class="flex items-center space-x-2 bg-blue-100 dark:bg-blue-900 px-3 py-2 rounded-lg">
        <span class="text-blue-900 dark:text-blue-100 font-medium">${tool.name}</span>
        <button
          onclick="window.removeToolFromComparison('${tool.id}')"
          class="text-blue-700 dark:text-blue-300 hover:text-blue-900 dark:hover:text-blue-100"
          data-testid="remove-tool-${tool.slug}"
        >
          ×
        </button>
      </div>
    `).join('');
  }

  function updateComparison() {
    const emptyState = document.getElementById('empty-state')!;
    const comparisonContainer = document.getElementById('comparison-container')!;
    
    if (selectedTools.length === 0) {
      emptyState.classList.remove('hidden');
      comparisonContainer.classList.add('hidden');
      return;
    }
    
    emptyState.classList.add('hidden');
    comparisonContainer.classList.remove('hidden');
    
    // Update header
    const header = document.getElementById('comparison-header')!;
    header.innerHTML = `
      <th class="p-4 text-left text-gray-900 dark:text-white font-bold sticky left-0 bg-white dark:bg-gray-800">Feature</th>
      ${selectedTools.map(tool => `
        <th class="p-4 text-center min-w-64">
          <div class="flex flex-col items-center space-y-2">
            ${tool.logo_url ? `<img src="${tool.logo_url}" alt="${tool.name}" class="w-16 h-16 object-contain" />` : ''}
            <a href="/tools/${tool.slug}" class="font-bold text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400">${tool.name}</a>
          </div>
        </th>
      `).join('')}
    `;
    
    // Build comparison body
    const rows = [
      { label: 'Rating', getValue: (tool: any) => `<div class="flex items-center justify-center"><span class="text-yellow-500 mr-1">★</span>${tool.rating.toFixed(1)} (${tool.review_count})</div>` },
      { label: 'Pricing', getValue: (tool: any) => `<span class="px-3 py-1 rounded-full text-xs font-medium ${getPricingClass(tool.pricing_type)}">${tool.pricing_type}</span>` },
      { label: 'Description', getValue: (tool: any) => tool.short_description || tool.description },
      { label: 'Key Features', getValue: (tool: any) => tool.features && tool.features.length > 0 ? `<ul class="text-left space-y-1">${tool.features.slice(0, 5).map((f: string) => `<li>• ${f}</li>`).join('')}</ul>` : 'N/A' },
      { label: 'Pros', getValue: (tool: any) => tool.pros && tool.pros.length > 0 ? `<ul class="text-left space-y-1 text-green-700 dark:text-green-400">${tool.pros.slice(0, 3).map((p: string) => `<li>✓ ${p}</li>`).join('')}</ul>` : 'N/A' },
      { label: 'Cons', getValue: (tool: any) => tool.cons && tool.cons.length > 0 ? `<ul class="text-left space-y-1 text-red-700 dark:text-red-400">${tool.cons.slice(0, 3).map((c: string) => `<li>✗ ${c}</li>`).join('')}</ul>` : 'N/A' },
      { label: 'Views', getValue: (tool: any) => tool.view_count.toLocaleString() },
      { label: 'Website', getValue: (tool: any) => tool.url ? `<a href="${tool.url}" target="_blank" class="text-blue-600 hover:text-blue-800 dark:text-blue-400">Visit →</a>` : 'N/A' },
    ];
    
    const body = document.getElementById('comparison-body')!;
    body.innerHTML = rows.map(row => `
      <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50">
        <td class="p-4 font-medium text-gray-900 dark:text-white sticky left-0 bg-white dark:bg-gray-800">${row.label}</td>
        ${selectedTools.map(tool => `
          <td class="p-4 text-center text-gray-700 dark:text-gray-300">${row.getValue(tool)}</td>
        `).join('')}
      </tr>
    `).join('');
  }

  function getPricingClass(pricingType: string): string {
    const classes = {
      free: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
      freemium: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
      paid: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200'
    };
    return classes[pricingType as keyof typeof classes] || classes.paid;
  }

  async function loadComparison(toolIds: string[]) {
    const loading = document.getElementById('loading')!;
    loading.classList.remove('hidden');
    
    try {
      const tools = await toolsApi.compare(toolIds);
      selectedTools = tools;
      updateSelectedTools();
      updateComparison();
    } catch (error) {
      console.error('Error loading comparison:', error);
      alert('Error loading tools for comparison');
    } finally {
      loading.classList.add('hidden');
    }
  }

  function updateURL() {
    if (selectedTools.length > 0) {
      const ids = selectedTools.map(t => t.id).join(',');
      const url = new URL(window.location.href);
      url.searchParams.set('tools', ids);
      window.history.pushState({}, '', url);
    } else {
      window.history.pushState({}, '', window.location.pathname);
    }
  }

  // AI Comparison functionality
  async function getAIComparison() {
    if (selectedTools.length < 2) {
      alert('Please select at least 2 tools to compare');
      return;
    }
    
    const aiBtn = document.getElementById('ai-compare-btn') as HTMLButtonElement;
    const aiSection = document.getElementById('ai-comparison-section')!;
    const aiContent = document.getElementById('ai-comparison-content')!;
    
    aiBtn.disabled = true;
    aiBtn.innerHTML = '<span class="animate-spin">⏳</span> Analyzing...';
    
    try {
      const API_URL = import.meta.env.PUBLIC_API_URL || '';
      const token = localStorage.getItem('token') || localStorage.getItem('auth_token');
      
      const response = await fetch(`${API_URL}/api/ai/quick-compare`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(selectedTools.map(t => t.id))
      });
      
      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.detail || 'AI comparison failed');
      }
      
      const data = await response.json();
      
      // Show AI section
      aiSection.classList.remove('hidden');

      // Build tool comparison cards HTML
      const toolCards = (data.tool_comparisons || []).map((tc: any) => `
        <div class="bg-white dark:bg-gray-800 rounded-xl p-5 border-2 ${tc.is_winner ? 'border-green-500 shadow-lg shadow-green-100 dark:shadow-green-900/20' : 'border-gray-200 dark:border-gray-700'}">
          <div class="flex items-center justify-between mb-3">
            <h5 class="text-lg font-bold text-gray-900 dark:text-white">${tc.name}</h5>
            ${tc.is_winner ? '<span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs font-bold rounded-full">AI Winner</span>' : ''}
          </div>
          ${tc.overview ? `<p class="text-sm text-gray-600 dark:text-gray-400 mb-3">${tc.overview}</p>` : ''}
          ${tc.ratings && Object.keys(tc.ratings).length > 0 ? `
            <div class="mb-3 space-y-1.5">
              ${['features','ease_of_use','pricing','customer_support'].filter(k => tc.ratings[k]).map((k: string) => `
                <div class="flex items-center gap-2">
                  <span class="text-xs text-gray-500 dark:text-gray-400 w-32 capitalize">${k.replace('_',' ')}</span>
                  <div class="flex-1 bg-gray-200 dark:bg-gray-700 rounded-full h-1.5">
                    <div class="bg-blue-500 h-1.5 rounded-full" style="width:${Math.min(100,(tc.ratings[k]/5)*100)}%"></div>
                  </div>
                  <span class="text-xs font-medium text-gray-700 dark:text-gray-300">${Number(tc.ratings[k]).toFixed(1)}</span>
                </div>
              `).join('')}
            </div>
          ` : ''}
          ${tc.pros?.length ? `
            <div class="mb-2">
              <p class="text-xs font-semibold text-green-700 dark:text-green-400 mb-1">Pros</p>
              <ul class="space-y-0.5">${tc.pros.map((p: string) => `<li class="text-xs text-gray-600 dark:text-gray-400 flex items-start gap-1"><span class="text-green-500 mt-0.5">✓</span>${p}</li>`).join('')}</ul>
            </div>
          ` : ''}
          ${tc.cons?.length ? `
            <div class="mb-2">
              <p class="text-xs font-semibold text-red-600 dark:text-red-400 mb-1">Cons</p>
              <ul class="space-y-0.5">${tc.cons.map((c: string) => `<li class="text-xs text-gray-600 dark:text-gray-400 flex items-start gap-1"><span class="text-red-500 mt-0.5">✗</span>${c}</li>`).join('')}</ul>
            </div>
          ` : ''}
          ${tc.best_for?.length ? `
            <div>
              <p class="text-xs font-semibold text-blue-600 dark:text-blue-400 mb-1">Best For</p>
              <div class="flex flex-wrap gap-1">${tc.best_for.map((b: string) => `<span class="text-xs px-2 py-0.5 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">${b}</span>`).join('')}</div>
            </div>
          ` : ''}
        </div>
      `).join('');
      
      // Render AI analysis with winner banner + comparison cards + recommendation
      aiContent.innerHTML = `
        <div class="space-y-5">
          ${data.winner ? `
            <div class="flex items-center gap-4 bg-gradient-to-r from-green-500 to-emerald-500 rounded-xl p-5 text-white shadow-lg">
              <div class="text-4xl">🏆</div>
              <div>
                <p class="text-sm font-medium opacity-90 mb-0.5">AI Recommended Winner</p>
                <h4 class="text-2xl font-bold">${data.winner}</h4>
              </div>
            </div>
          ` : ''}
          
          ${data.summary ? `
            <div class="bg-white dark:bg-gray-800 rounded-xl p-5 border border-gray-200 dark:border-gray-700">
              <h4 class="font-semibold text-gray-900 dark:text-white mb-2 flex items-center gap-2">
                <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                AI Summary
              </h4>
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed">${data.summary}</p>
            </div>
          ` : ''}

          ${toolCards ? `
            <div>
              <h4 class="font-semibold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                AI Tool Analysis
              </h4>
              <div class="grid grid-cols-1 md:grid-cols-${Math.min(data.tool_comparisons?.length || 1, 3)} gap-4">
                ${toolCards}
              </div>
            </div>
          ` : ''}
          
          ${data.recommendation ? `
            <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-5 border border-blue-200 dark:border-blue-700">
              <h4 class="font-semibold text-blue-800 dark:text-blue-200 mb-2 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                Recommendation
              </h4>
              <p class="text-blue-700 dark:text-blue-300 leading-relaxed">${data.recommendation}</p>
            </div>
          ` : ''}
        </div>
      `;
      
      // Scroll to AI section
      aiSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      
    } catch (error: any) {
      console.error('AI comparison error:', error);
      aiSection.classList.remove('hidden');
      aiContent.innerHTML = `
        <div class="bg-red-50 dark:bg-red-900/30 rounded-lg p-4 border border-red-200 dark:border-red-800">
          <h4 class="font-semibold text-red-800 dark:text-red-200 mb-2">⚠️ Error</h4>
          <p class="text-red-700 dark:text-red-300">${error.message || 'Failed to generate AI comparison. Please try again.'}</p>
        </div>
      `;
    } finally {
      aiBtn.disabled = false;
      aiBtn.innerHTML = 'Get AI Analysis';
    }
  }
  
  // Setup AI compare button
  document.getElementById('ai-compare-btn')?.addEventListener('click', getAIComparison);

  // Authentication check before initializing the page
  function checkAuthentication() {
    const token = localStorage.getItem('token') || localStorage.getItem('auth_token');
    const overlay = document.getElementById('auth-gate-overlay');
    const loadingSpinner = document.getElementById('auth-loading');
    const gateContent = document.getElementById('auth-gate-content');
    
    if (!token) {
      // Not logged in - show login gate
      if (loadingSpinner) loadingSpinner.classList.add('hidden');
      if (gateContent) gateContent.classList.remove('hidden');
      return false;
    }
    
    // User is logged in - remove overlay and continue
    if (overlay) overlay.remove();
    return true;
  }

  // Check auth first, then init if authenticated
  if (checkAuthentication()) {
    init();
  }
</script>
