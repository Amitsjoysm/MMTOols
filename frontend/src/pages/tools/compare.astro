---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Compare Tools - MarketMindAI',
  description: 'Compare AI tools and business solutions side-by-side to make informed decisions.',
};
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Compare Tools
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Select tools to compare their features, pricing, and ratings side-by-side.
      </p>
    </div>

    <!-- Tool Selection -->
    <div id="tool-selector" class="mb-8">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Select Tools to Compare (max 5)</h2>
        
        <!-- Search for tools -->
        <div class="mb-4">
          <input
            type="text"
            id="tool-search"
            placeholder="Search for tools to add..."
            class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            data-testid="tool-search-input"
          />
        </div>
        
        <!-- Search results -->
        <div id="search-results" class="hidden mb-4 max-h-60 overflow-y-auto space-y-2" data-testid="search-results"></div>
        
        <!-- Selected tools -->
        <div id="selected-tools" class="flex flex-wrap gap-2 min-h-12" data-testid="selected-tools"></div>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loading" class="hidden text-center py-12">
      <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      <p class="mt-4 text-gray-600 dark:text-gray-400">Loading comparison...</p>
    </div>

    <!-- Comparison Table -->
    <div id="comparison-container" class="hidden" data-testid="comparison-table">
      <div class="overflow-x-auto">
        <table class="w-full bg-white dark:bg-gray-800 rounded-lg shadow-md">
          <thead>
            <tr id="comparison-header" class="border-b border-gray-200 dark:border-gray-700">
              <th class="p-4 text-left text-gray-900 dark:text-white font-bold sticky left-0 bg-white dark:bg-gray-800">Feature</th>
            </tr>
          </thead>
          <tbody id="comparison-body">
            <!-- Comparison rows will be added here -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="text-center py-12">
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-4">
        Search and select tools above to start comparing.
      </p>
      <a href="/tools" class="inline-block text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">
        Browse All Tools →
      </a>
    </div>
  </div>
</Layout>

<script>
  import { toolsApi } from '~/utils/api';

  let selectedTools: any[] = [];
  let searchTimeout: any;
  let allToolsCache: any[] = [];

  async function init() {
    // Load from URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    const toolIds = urlParams.get('tools');
    
    if (toolIds) {
      const ids = toolIds.split(',');
      await loadComparison(ids);
    }
    
    setupEventListeners();
    
    // Load all tools for search
    try {
      allToolsCache = await toolsApi.getAll({ limit: 100 });
    } catch (error) {
      console.error('Error loading tools:', error);
    }
  }

  function setupEventListeners() {
    const searchInput = document.getElementById('tool-search') as HTMLInputElement;
    
    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => searchTools(searchInput.value), 300);
    });
  }

  function searchTools(query: string) {
    const resultsDiv = document.getElementById('search-results')!;
    
    if (!query || query.length < 2) {
      resultsDiv.classList.add('hidden');
      return;
    }
    
    const filtered = allToolsCache
      .filter(tool => 
        !selectedTools.find(st => st.id === tool.id) &&
        (tool.name.toLowerCase().includes(query.toLowerCase()) ||
         tool.description.toLowerCase().includes(query.toLowerCase()))
      )
      .slice(0, 5);
    
    if (filtered.length === 0) {
      resultsDiv.classList.add('hidden');
      return;
    }
    
    resultsDiv.innerHTML = filtered.map(tool => `
      <button
        onclick="window.addToolToComparison('${tool.id}')"
        class="w-full text-left p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors flex items-center space-x-3"
        data-testid="add-tool-${tool.slug}"
      >
        ${tool.logo_url ? `<img src="${tool.logo_url}" alt="${tool.name}" class="w-10 h-10 object-contain rounded" />` : ''}
        <div class="flex-1">
          <div class="font-medium text-gray-900 dark:text-white">${tool.name}</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">${tool.short_description || ''}</div>
        </div>
      </button>
    `).join('');
    
    resultsDiv.classList.remove('hidden');
  }

  (window as any).addToolToComparison = function(toolId: string) {
    if (selectedTools.length >= 5) {
      alert('Maximum 5 tools can be compared at once');
      return;
    }
    
    const tool = allToolsCache.find(t => t.id === toolId);
    if (!tool) return;
    
    selectedTools.push(tool);
    updateSelectedTools();
    updateComparison();
    
    // Clear search
    const searchInput = document.getElementById('tool-search') as HTMLInputElement;
    searchInput.value = '';
    document.getElementById('search-results')!.classList.add('hidden');
    
    // Update URL
    updateURL();
  };

  (window as any).removeToolFromComparison = function(toolId: string) {
    selectedTools = selectedTools.filter(t => t.id !== toolId);
    updateSelectedTools();
    updateComparison();
    updateURL();
  };

  function updateSelectedTools() {
    const container = document.getElementById('selected-tools')!;
    
    if (selectedTools.length === 0) {
      container.innerHTML = '<p class="text-gray-500 dark:text-gray-400 py-2">No tools selected</p>';
      return;
    }
    
    container.innerHTML = selectedTools.map(tool => `
      <div class="flex items-center space-x-2 bg-blue-100 dark:bg-blue-900 px-3 py-2 rounded-lg">
        <span class="text-blue-900 dark:text-blue-100 font-medium">${tool.name}</span>
        <button
          onclick="window.removeToolFromComparison('${tool.id}')"
          class="text-blue-700 dark:text-blue-300 hover:text-blue-900 dark:hover:text-blue-100"
          data-testid="remove-tool-${tool.slug}"
        >
          ×
        </button>
      </div>
    `).join('');
  }

  function updateComparison() {
    const emptyState = document.getElementById('empty-state')!;
    const comparisonContainer = document.getElementById('comparison-container')!;
    
    if (selectedTools.length === 0) {
      emptyState.classList.remove('hidden');
      comparisonContainer.classList.add('hidden');
      return;
    }
    
    emptyState.classList.add('hidden');
    comparisonContainer.classList.remove('hidden');
    
    // Update header
    const header = document.getElementById('comparison-header')!;
    header.innerHTML = `
      <th class="p-4 text-left text-gray-900 dark:text-white font-bold sticky left-0 bg-white dark:bg-gray-800">Feature</th>
      ${selectedTools.map(tool => `
        <th class="p-4 text-center min-w-64">
          <div class="flex flex-col items-center space-y-2">
            ${tool.logo_url ? `<img src="${tool.logo_url}" alt="${tool.name}" class="w-16 h-16 object-contain" />` : ''}
            <a href="/tools/${tool.slug}" class="font-bold text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400">${tool.name}</a>
          </div>
        </th>
      `).join('')}
    `;
    
    // Build comparison body
    const rows = [
      { label: 'Rating', getValue: (tool: any) => `<div class="flex items-center justify-center"><span class="text-yellow-500 mr-1">★</span>${tool.rating.toFixed(1)} (${tool.review_count})</div>` },
      { label: 'Pricing', getValue: (tool: any) => `<span class="px-3 py-1 rounded-full text-xs font-medium ${getPricingClass(tool.pricing_type)}">${tool.pricing_type}</span>` },
      { label: 'Description', getValue: (tool: any) => tool.short_description || tool.description },
      { label: 'Key Features', getValue: (tool: any) => tool.features && tool.features.length > 0 ? `<ul class="text-left space-y-1">${tool.features.slice(0, 5).map((f: string) => `<li>• ${f}</li>`).join('')}</ul>` : 'N/A' },
      { label: 'Pros', getValue: (tool: any) => tool.pros && tool.pros.length > 0 ? `<ul class="text-left space-y-1 text-green-700 dark:text-green-400">${tool.pros.slice(0, 3).map((p: string) => `<li>✓ ${p}</li>`).join('')}</ul>` : 'N/A' },
      { label: 'Cons', getValue: (tool: any) => tool.cons && tool.cons.length > 0 ? `<ul class="text-left space-y-1 text-red-700 dark:text-red-400">${tool.cons.slice(0, 3).map((c: string) => `<li>✗ ${c}</li>`).join('')}</ul>` : 'N/A' },
      { label: 'Views', getValue: (tool: any) => tool.view_count.toLocaleString() },
      { label: 'Website', getValue: (tool: any) => tool.url ? `<a href="${tool.url}" target="_blank" class="text-blue-600 hover:text-blue-800 dark:text-blue-400">Visit →</a>` : 'N/A' },
    ];
    
    const body = document.getElementById('comparison-body')!;
    body.innerHTML = rows.map(row => `
      <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50">
        <td class="p-4 font-medium text-gray-900 dark:text-white sticky left-0 bg-white dark:bg-gray-800">${row.label}</td>
        ${selectedTools.map(tool => `
          <td class="p-4 text-center text-gray-700 dark:text-gray-300">${row.getValue(tool)}</td>
        `).join('')}
      </tr>
    `).join('');
  }

  function getPricingClass(pricingType: string): string {
    const classes = {
      free: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
      freemium: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
      paid: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200'
    };
    return classes[pricingType as keyof typeof classes] || classes.paid;
  }

  async function loadComparison(toolIds: string[]) {
    const loading = document.getElementById('loading')!;
    loading.classList.remove('hidden');
    
    try {
      const tools = await toolsApi.compare(toolIds);
      selectedTools = tools;
      updateSelectedTools();
      updateComparison();
    } catch (error) {
      console.error('Error loading comparison:', error);
      alert('Error loading tools for comparison');
    } finally {
      loading.classList.add('hidden');
    }
  }

  function updateURL() {
    if (selectedTools.length > 0) {
      const ids = selectedTools.map(t => t.id).join(',');
      const url = new URL(window.location.href);
      url.searchParams.set('tools', ids);
      window.history.pushState({}, '', url);
    } else {
      window.history.pushState({}, '', window.location.pathname);
    }
  }

  init();
</script>
