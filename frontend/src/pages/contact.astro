---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact TechResona - Get Free Consultation | Pune',
  description: 'Contact TechResona for cloud solutions, web development, AI automation, and IT services. Located in Kharadi, Pune. Call +91 7517402788 or email info@techresona.com',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText 
    tagline="Contact Us" 
    title="Let's Build Something Amazing Together!" 
  />

  <ContactUs
    id="form"
    title="Get in Touch Today!"
    subtitle="Have a project in mind or need expert advice? Our team is here to help. Fill out the form below and we'll get back to you within 24 hours."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Full Name',
        placeholder: 'Your name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Work Email',
        placeholder: 'your.email@company.com',
      },
      {
        type: 'tel',
        name: 'phone',
        label: 'Phone Number',
        placeholder: '+91 XXXXXXXXXX',
      },
      {
        type: 'text',
        name: 'company',
        label: 'Company Name',
        placeholder: 'Your company',
      },
    ]}
    textarea={{
      label: 'How can we help you?',
      placeholder: 'Tell us about your project requirements, challenges, or questions...',
    }}
    disclaimer={{
      label:
        'By submitting this form, you agree to our privacy policy and consent to being contacted by TechResona regarding your inquiry.',
    }}
    description="Our team typically responds within 24 hours during business days."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="How Can We Help You?"
    tagline="Our Services"
    columns={3}
    items={[
      {
        title: 'Cloud Migration',
        description: `Need help moving to Azure or AWS? We provide end-to-end cloud migration services with zero downtime guarantee.`,
        icon: 'tabler:cloud',
      },
      {
        title: 'Web Development',
        description:
          'Looking for a new website or web application? Our team creates stunning, high-performance solutions.',
        icon: 'tabler:world-www',
      },
      {
        title: 'Business Automation',
        description:
          'Want to automate repetitive tasks? We implement RPA and AI-powered workflows that save time and reduce errors.',
        icon: 'tabler:robot',
      },
      {
        title: 'SEO Services',
        description:
          'Need more website traffic? Our proven SEO strategies help you rank higher on Google and attract qualified leads.',
        icon: 'tabler:seo',
      },
      {
        title: 'Software Licenses',
        description:
          'Looking for Microsoft 365 or Google Workspace? We offer competitive pricing with complete setup and support.',
        icon: 'tabler:license',
      },
      {
        title: 'IT Consulting',
        description:
          'Need strategic technology advice? Our consultants help you make informed decisions about your IT investments.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Contact Information Widget ************** -->

  <Features2
    title="Other Ways to Reach Us"
    tagline="Contact Information"
    columns={3}
    items={[
      {
        title: 'Email',
        description: '<a href="mailto:info@techresona.com" class="text-blue-600 hover:underline">info@techresona.com</a><br>We respond within 24 hours',
        icon: 'tabler:mail',
      },
      {
        title: 'Phone',
        description: '<a href="tel:+917517402788" class="text-blue-600 hover:underline">+91 7517402788</a><br>Mon-Sat: 9:00 AM - 7:00 PM IST',
        icon: 'tabler:phone',
      },
      {
        title: 'Location',
        description: 'TechResona Pvt Ltd<br>Kharadi, Pune 411047<br>Maharashtra, India',
        icon: 'tabler:map-pin',
      },
      {
        title: 'LinkedIn',
        description: '<a href="https://www.linkedin.com/company/techresona-services/" target="_blank" class="text-blue-600 hover:underline">Connect with us</a><br>Follow for updates & insights',
        icon: 'tabler:brand-linkedin',
      },
      {
        title: 'Emergency Support',
        description: 'For existing clients with urgent issues<br>24/7 emergency hotline available',
        icon: 'tabler:alert-circle',
      },
      {
        title: 'Schedule a Meeting',
        description: 'Prefer a video call?<br>Book a free 30-min consultation',
        icon: 'tabler:calendar',
      },
    ]}
  />

  <!-- Why Choose Section -->

  <Features2
    title="Why Contact TechResona?"
    columns={2}
    items={[
      {
        title: 'Free Consultation',
        description: 'Get expert advice at no cost. We\'ll analyze your needs and provide honest recommendations.',
        icon: 'tabler:gift',
      },
      {
        title: 'Quick Response',
        description: 'We value your time. Expect a detailed response within 24 hours, often much sooner.',
        icon: 'tabler:clock',
      },
      {
        title: 'No Pressure Sales',
        description: 'We believe in building relationships, not pushing sales. Get honest advice focused on your success.',
        icon: 'tabler:heart-handshake',
      },
      {
        title: 'Proven Track Record',
        description: '200+ satisfied clients and 500+ successful projects. Read our case studies and testimonials.',
        icon: 'tabler:award',
      },
    ]}
  />
</Layout>
