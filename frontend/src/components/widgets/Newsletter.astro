---
export interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
}

const {
  title = 'Subscribe to Our Newsletter',
  subtitle = 'Get the latest updates on AI tools, expert insights, and industry trends delivered to your inbox.',
  tagline = 'Stay Updated',
} = Astro.props;
---

<section class="bg-blue-600 dark:bg-blue-800 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8">
      {tagline && (
        <p class="text-blue-100 dark:text-blue-200 text-sm font-semibold uppercase tracking-wide mb-2">
          {tagline}
        </p>
      )}
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        {title}
      </h2>
      {subtitle && (
        <p class="text-blue-100 dark:text-blue-200 text-lg max-w-2xl mx-auto">
          {subtitle}
        </p>
      )}
    </div>

    <form id="newsletter-form" class="max-w-xl mx-auto">
      <div class="flex flex-col sm:flex-row gap-3">
        <input
          type="email"
          id="newsletter-email"
          name="email"
          required
          placeholder="Enter your email address"
          class="flex-1 px-6 py-4 rounded-lg border-2 border-transparent focus:border-white focus:ring-2 focus:ring-white/50 text-gray-900 dark:text-white bg-white dark:bg-gray-800 transition-all"
          data-testid="newsletter-email-input"
        />
        <button
          type="submit"
          class="px-8 py-4 bg-white text-blue-600 rounded-lg font-semibold hover:bg-blue-50 transition-colors shadow-lg hover:shadow-xl whitespace-nowrap"
          data-testid="newsletter-subscribe-btn"
        >
          Subscribe
        </button>
      </div>
      <div id="newsletter-message" class="mt-4 hidden"></div>
      <p class="text-blue-100 dark:text-blue-200 text-xs mt-3 text-center">
        We respect your privacy. Unsubscribe at any time.
      </p>
    </form>
  </div>
</section>

<script>
  // Dynamic API URL detection
  function getApiBaseUrl() {
    if (typeof window !== 'undefined') {
      const currentOrigin = window.location.origin;
      if (currentOrigin.includes('preview.app.github.dev') || 
          currentOrigin.includes('github.dev') ||
          currentOrigin.includes('preview.emergentagent.com')) {
        return currentOrigin.replace(':3000', ':8001').replace('3000-', '8001-');
      }
    }
    return 'http://localhost:8001';
  }
  
  const API_BASE_URL = getApiBaseUrl();
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const messageDiv = document.getElementById('newsletter-message');

  if (form && messageDiv) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const emailInput = document.getElementById('newsletter-email') as HTMLInputElement;
      const email = emailInput.value;
      
      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Subscribing...';
      messageDiv.classList.add('hidden');

      try {
        const response = await fetch(`${API_BASE_URL}/api/newsletter/subscribe`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'footer' }),
        });

        if (response.ok) {
          messageDiv.className = 'mt-4 p-4 bg-white dark:bg-gray-800 text-green-600 dark:text-green-400 rounded-lg text-center font-medium';
          messageDiv.textContent = '🎉 Successfully subscribed! Check your inbox for confirmation.';
          messageDiv.classList.remove('hidden');
          form.reset();
        } else {
          const error = await response.json();
          throw new Error(error.detail || 'Subscription failed');
        }
      } catch (error: any) {
        messageDiv.className = 'mt-4 p-4 bg-white dark:bg-gray-800 text-red-600 dark:text-red-400 rounded-lg text-center font-medium';
        messageDiv.textContent = error.message || 'Failed to subscribe. Please try again.';
        messageDiv.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  }
</script>
