<!-- Admin Route Protection -->
<!-- This script runs on admin pages to validate authentication via backend API -->

<div id="admin-protection-overlay" class="fixed inset-0 bg-gray-900 z-[9999] flex items-center justify-center">
  <div class="text-center text-white">
    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-white mx-auto mb-4"></div>
    <p>Verifying access...</p>
  </div>
</div>

<script>
  // Validate admin access by verifying token with backend
  async function validateAdminAccess() {
    const overlay = document.getElementById('admin-protection-overlay');
    const token = localStorage.getItem('token') || localStorage.getItem('auth_token');
    
    // Not logged in - redirect immediately
    if (!token) {
      window.location.replace('/admin/login?redirect=' + encodeURIComponent(window.location.pathname));
      return;
    }
    
    // Get API base URL
    function getApiBaseUrl() {
      if (typeof window !== 'undefined') {
        const currentOrigin = window.location.origin;
        if (currentOrigin.includes('preview.app.github.dev') || 
            currentOrigin.includes('github.dev') ||
            currentOrigin.includes('preview.emergentagent.com')) {
          return currentOrigin.replace(':3000', ':8001').replace('3000-', '8001-');
        }
      }
      return 'http://localhost:8001';
    }
    
    const API_URL = getApiBaseUrl();
    
    try {
      // Verify token and get user info from backend
      const response = await fetch(`${API_URL}/api/auth/me`, {
        method: 'GET',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        }
      });
      
      if (!response.ok) {
        // Token invalid or expired
        localStorage.removeItem('token');
        localStorage.removeItem('auth_token');
        localStorage.removeItem('user_data');
        window.location.replace('/admin/login?error=session_expired');
        return;
      }
      
      const user = await response.json();
      
      // Validate role - ONLY admin or superadmin allowed
      if (user.role !== 'admin' && user.role !== 'superadmin') {
        // User is authenticated but doesn't have admin privileges
        overlay.innerHTML = `
          <div class="text-center text-white p-8">
            <svg class="w-16 h-16 mx-auto mb-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <h2 class="text-2xl font-bold mb-2">Access Denied</h2>
            <p class="mb-6">You don't have permission to access the admin area.</p>
            <a href="/" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Go to Home</a>
          </div>
        `;
        return;
      }
      
      // Store validated user data
      localStorage.setItem('user_data', JSON.stringify(user));
      
      // Access granted - remove overlay
      if (overlay) {
        overlay.remove();
      }
      
    } catch (error) {
      console.error('Admin validation error:', error);
      // Network error - show error state
      overlay.innerHTML = `
        <div class="text-center text-white p-8">
          <svg class="w-16 h-16 mx-auto mb-4 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h2 class="text-2xl font-bold mb-2">Connection Error</h2>
          <p class="mb-6">Unable to verify your access. Please check your connection and try again.</p>
          <button onclick="window.location.reload()" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Retry</button>
        </div>
      `;
    }
  }
  
  // Run validation immediately
  validateAdminAccess();
</script>
