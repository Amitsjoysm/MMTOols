---
/**
 * Blog Rich Text Editor with Image Upload Support
 * Features: Images (max 1MB, controllable size), Videos, Code Blocks, Links, Tables, Formatting
 */
---

<div class="rich-editor-wrapper">
  <!-- Editor Toolbar -->
  <div id="editor-toolbar" class="flex flex-wrap gap-1 p-2 border border-gray-300 dark:border-gray-600 rounded-t-lg bg-gray-50 dark:bg-gray-700">
    <!-- Text Formatting -->
    <button type="button" class="editor-btn tiptap-button" data-command="bold" title="Bold (Ctrl+B)">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4h8a4 4 0 010 8H6zM6 12h9a4 4 0 010 8H6z"/></svg>
    </button>
    <button type="button" class="editor-btn tiptap-button" data-command="italic" title="Italic (Ctrl+I)">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m-4 4h8m-8 8h8"/></svg>
    </button>
    <button type="button" class="editor-btn tiptap-button" data-command="underline" title="Underline">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v6a5 5 0 0010 0V4M5 21h14"/></svg>
    </button>
    <button type="button" class="editor-btn tiptap-button" data-command="strike" title="Strikethrough">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12h18M9 5v4m6-4v4M9 19v-4m6 4v-4"/></svg>
    </button>

    <div class="w-px h-6 bg-gray-300 dark:bg-gray-500 mx-1"></div>

    <!-- Headings -->
    <button type="button" class="editor-btn tiptap-button" data-command="heading" data-level="1" title="Heading 1">
      <span class="font-bold text-lg">H1</span>
    </button>
    <button type="button" class="editor-btn tiptap-button" data-command="heading" data-level="2" title="Heading 2">
      <span class="font-bold">H2</span>
    </button>
    <button type="button" class="editor-btn tiptap-button" data-command="heading" data-level="3" title="Heading 3">
      <span class="font-bold text-sm">H3</span>
    </button>

    <div class="w-px h-6 bg-gray-300 dark:bg-gray-500 mx-1"></div>

    <!-- Lists -->
    <button type="button" class="editor-btn tiptap-button" data-command="bulletList" title="Bullet List">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
    </button>
    <button type="button" class="editor-btn tiptap-button" data-command="orderedList" title="Numbered List">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
    </button>
    <button type="button" class="editor-btn tiptap-button" data-command="blockquote" title="Quote">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l-4 4 4 4m8-8l4 4-4 4"/></svg>
    </button>

    <div class="w-px h-6 bg-gray-300 dark:bg-gray-500 mx-1"></div>

    <!-- Media & Code -->
    <button type="button" class="editor-btn tiptap-button" data-command="image" title="Insert Image">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
    </button>
    <button type="button" class="editor-btn tiptap-button" data-command="video" title="Insert Video (YouTube/Vimeo)">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
    </button>
    <button type="button" class="editor-btn tiptap-button" data-command="link" title="Insert Link">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
    </button>
    <button type="button" class="editor-btn tiptap-button" data-command="codeBlock" title="Code Block">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
    </button>

    <div class="w-px h-6 bg-gray-300 dark:bg-gray-500 mx-1"></div>

    <!-- Actions -->
    <button type="button" class="editor-btn tiptap-button" data-command="horizontalRule" title="Horizontal Line">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg>
    </button>
    <button type="button" class="editor-btn tiptap-button" data-command="undo" title="Undo">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
    </button>
    <button type="button" class="editor-btn tiptap-button" data-command="redo" title="Redo">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 10h-10a8 8 0 00-8 8v2m18-10l-6 6m6-6l-6-6"/></svg>
    </button>
  </div>
  
  <!-- Editor Content Area -->
  <div 
    id="editor-content" 
    class="min-h-[400px] max-h-[600px] overflow-y-auto p-4 border border-t-0 border-gray-300 dark:border-gray-600 rounded-b-lg bg-white dark:bg-gray-800 prose prose-sm sm:prose lg:prose-lg dark:prose-invert max-w-none focus:outline-none"
  ></div>

  <!-- Hidden textarea for form submission -->
  <textarea 
    id="blog-content-html" 
    name="content" 
    class="hidden"
  ></textarea>

  <!-- Character/Word Count -->
  <div class="mt-2 flex justify-between text-xs text-gray-500 dark:text-gray-400">
    <span id="char-count">0 characters</span>
    <span id="word-count">0 words</span>
  </div>
</div>

<!-- Image Upload Modal -->
<div id="image-upload-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-md w-full p-6">
    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Upload Image</h3>
    
    <!-- Upload Options -->
    <div class="mb-4">
      <div class="flex gap-2">
        <button type="button" id="upload-tab" class="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg">Upload File</button>
        <button type="button" id="url-tab" class="flex-1 px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg">Image URL</button>
      </div>
    </div>

    <!-- Upload Section -->
    <div id="upload-section" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Select Image (Max 1MB)</label>
        <input 
          type="file" 
          id="image-file-input" 
          accept="image/*"
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
        />
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Supported: JPG, PNG, GIF, WebP (Max: 1MB)</p>
      </div>

      <!-- Image Preview -->
      <div id="image-preview-container" class="hidden">
        <img id="image-preview" src="" alt="Preview" class="w-full rounded-lg border border-gray-300 dark:border-gray-600" />
        <p id="file-size-info" class="text-xs text-gray-500 dark:text-gray-400 mt-1"></p>
      </div>

      <!-- Dimension Controls -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Max Width (px)</label>
          <input 
            type="number" 
            id="image-max-width" 
            value="800"
            min="200"
            max="1200"
            step="50"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Max Height (px)</label>
          <input 
            type="number" 
            id="image-max-height" 
            value="600"
            min="200"
            max="1000"
            step="50"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
          />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Alt Text</label>
        <input 
          type="text" 
          id="upload-image-alt" 
          placeholder="Describe the image"
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
        />
      </div>

      <!-- Upload Progress -->
      <div id="upload-progress" class="hidden">
        <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
          <div id="upload-progress-bar" class="bg-blue-600 h-2.5 rounded-full" style="width: 0%"></div>
        </div>
        <p id="upload-status" class="text-xs text-gray-500 dark:text-gray-400 mt-1">Uploading...</p>
      </div>
    </div>

    <!-- URL Section -->
    <div id="url-section" class="hidden space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Image URL</label>
        <input 
          type="url" 
          id="image-url-input" 
          placeholder="https://example.com/image.jpg"
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Alt Text</label>
        <input 
          type="text" 
          id="url-image-alt" 
          placeholder="Describe the image"
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
        />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Max Width (px)</label>
          <input 
            type="number" 
            id="url-image-width" 
            value="800"
            min="200"
            max="1200"
            step="50"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Max Height (px)</label>
          <input 
            type="number" 
            id="url-image-height" 
            value="600"
            min="200"
            max="1000"
            step="50"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
          />
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex justify-end gap-2 mt-6">
      <button type="button" id="cancel-image-btn" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300">
        Cancel
      </button>
      <button type="button" id="insert-image-btn" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
        Insert Image
      </button>
    </div>
  </div>
</div>

<style>
  .rich-editor-wrapper :global(.ProseMirror) {
    min-height: 400px;
    outline: none;
  }

  .rich-editor-wrapper :global(.ProseMirror p.is-editor-empty:first-child::before) {
    color: #adb5bd;
    content: attr(data-placeholder);
    float: left;
    height: 0;
    pointer-events: none;
  }

  .rich-editor-wrapper :global(.ProseMirror img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1rem auto;
    border-radius: 0.5rem;
  }

  .rich-editor-wrapper :global(.ProseMirror pre) {
    background: #1e293b;
    color: #e2e8f0;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .rich-editor-wrapper :global(.ProseMirror code) {
    background: #f1f5f9;
    color: #e11d48;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }

  .rich-editor-wrapper :global(.ProseMirror pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
  }

  .rich-editor-wrapper :global(.ProseMirror table) {
    border-collapse: collapse;
    margin: 1rem 0;
    width: 100%;
  }

  .rich-editor-wrapper :global(.ProseMirror th),
  .rich-editor-wrapper :global(.ProseMirror td) {
    border: 1px solid #e2e8f0;
    padding: 0.5rem 1rem;
  }

  .rich-editor-wrapper :global(.ProseMirror th) {
    background: #f1f5f9;
    font-weight: 600;
  }

  .rich-editor-wrapper :global(.ProseMirror iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.5rem;
    margin: 1rem 0;
  }

  .rich-editor-wrapper :global(.ProseMirror hr) {
    border: none;
    border-top: 2px solid #e2e8f0;
    margin: 2rem 0;
  }

  .rich-editor-wrapper :global(.ProseMirror blockquote) {
    border-left: 4px solid #3b82f6;
    padding-left: 1rem;
    margin: 1rem 0;
    font-style: italic;
    color: #64748b;
  }

  .rich-editor-wrapper :global(.ProseMirror a) {
    color: #3b82f6;
    text-decoration: underline;
  }

  .rich-editor-wrapper :global(.ProseMirror a:hover) {
    color: #2563eb;
  }

  .rich-editor-wrapper :global(.tiptap-button) {
    @apply p-2 rounded hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 transition-colors;
  }

  .rich-editor-wrapper :global(.tiptap-button.is-active) {
    @apply bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-400;
  }
</style>

<script>
  import { initRichTextEditor } from '~/lib/richTextEditor';

  // Initialize editor when the page loads
  if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      // Get initial content if editing
      const contentTextarea = document.getElementById('content') as HTMLTextAreaElement;
      const initialContent = contentTextarea?.value || '';
      
      // Initialize the rich text editor
      try {
        const editor = initRichTextEditor(initialContent);
        console.log('Rich text editor initialized successfully');
      } catch (error) {
        console.error('Failed to initialize rich text editor:', error);
      }
    });
  }
</script>