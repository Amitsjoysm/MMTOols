[Unit]
Description=MarketMindAI Backend (FastAPI)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/marketmindai/backend
ExecStart=/var/www/marketmindai/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8001 --workers 4
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=marketmindai-backend

# Environment
EnvironmentFile=/var/www/marketmindai/backend/.env

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/marketmindai/backend/uploads

[Install]
WantedBy=multi-user.target
